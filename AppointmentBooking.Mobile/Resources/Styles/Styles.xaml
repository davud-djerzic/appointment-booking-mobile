<?xml version="1.0" encoding="UTF-8" ?>
<ResourceDictionary
    xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
    xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml">

    <!--
        App-wide font: Playfair Display, a Didone serif (SIL Open Font License, see ThirdPartyNotices).
        Change it in one place here. Keyed styles below must also set FontFamily,
        because an explicit Style replaces the implicit one.
        FontAttributes="Bold" switches to the real Bold font file through the style
        triggers below, instead of an artificially emboldened Regular.
    -->
    <x:String x:Key="AppFontFamily">PlayfairDisplay</x:String>
    <x:String x:Key="AppFontFamilyBold">PlayfairDisplayBold</x:String>

    <Style TargetType="Label">
        <Setter Property="FontFamily"
                Value="{StaticResource AppFontFamily}" />
        <Style.Triggers>
            <Trigger TargetType="Label" Property="FontAttributes" Value="Bold">
                <Setter Property="FontFamily"
                        Value="{StaticResource AppFontFamilyBold}" />
            </Trigger>
        </Style.Triggers>
    </Style>

    <Style TargetType="Button">
        <Setter Property="FontFamily"
                Value="{StaticResource AppFontFamily}" />
        <Style.Triggers>
            <Trigger TargetType="Button" Property="FontAttributes" Value="Bold">
                <Setter Property="FontFamily"
                        Value="{StaticResource AppFontFamilyBold}" />
            </Trigger>
        </Style.Triggers>
    </Style>

    <Style TargetType="SearchBar">
        <Setter Property="FontFamily"
                Value="{StaticResource AppFontFamily}" />
        <Style.Triggers>
            <Trigger TargetType="SearchBar" Property="FontAttributes" Value="Bold">
                <Setter Property="FontFamily"
                        Value="{StaticResource AppFontFamilyBold}" />
            </Trigger>
        </Style.Triggers>
    </Style>

    <Style TargetType="ContentPage">
        <Setter Property="BackgroundColor"
                Value="{StaticResource BrandBackground}" />
    </Style>

    <Style TargetType="Entry">
        <Setter Property="FontFamily"
                Value="{StaticResource AppFontFamily}" />
        <Setter Property="BackgroundColor"
                Value="{StaticResource TextBoxBackground}" />
        <Setter Property="TextColor"
                Value="{StaticResource TextPrimary}" />
        <Style.Triggers>
            <Trigger TargetType="Entry" Property="FontAttributes" Value="Bold">
                <Setter Property="FontFamily"
                        Value="{StaticResource AppFontFamilyBold}" />
            </Trigger>
        </Style.Triggers>
    </Style>

    <Style TargetType="Editor">
        <Setter Property="FontFamily"
                Value="{StaticResource AppFontFamily}" />
        <Setter Property="BackgroundColor"
                Value="{StaticResource TextBoxBackground}" />
        <Setter Property="TextColor"
                Value="{StaticResource TextPrimary}" />
        <Style.Triggers>
            <Trigger TargetType="Editor" Property="FontAttributes" Value="Bold">
                <Setter Property="FontFamily"
                        Value="{StaticResource AppFontFamilyBold}" />
            </Trigger>
        </Style.Triggers>
    </Style>

    <Style TargetType="Picker">
        <Setter Property="FontFamily"
                Value="{StaticResource AppFontFamily}" />
        <Setter Property="BackgroundColor"
                Value="{StaticResource TextBoxBackground}" />
        <Setter Property="TextColor"
                Value="{StaticResource TextPrimary}" />
        <Style.Triggers>
            <Trigger TargetType="Picker" Property="FontAttributes" Value="Bold">
                <Setter Property="FontFamily"
                        Value="{StaticResource AppFontFamilyBold}" />
            </Trigger>
        </Style.Triggers>
    </Style>

    <Style TargetType="DatePicker">
        <Setter Property="FontFamily"
                Value="{StaticResource AppFontFamily}" />
        <Setter Property="BackgroundColor"
                Value="{StaticResource TextBoxBackground}" />
        <Setter Property="TextColor"
                Value="{StaticResource TextPrimary}" />
        <Style.Triggers>
            <Trigger TargetType="DatePicker" Property="FontAttributes" Value="Bold">
                <Setter Property="FontFamily"
                        Value="{StaticResource AppFontFamilyBold}" />
            </Trigger>
        </Style.Triggers>
    </Style>

    <Style TargetType="TimePicker">
        <Setter Property="FontFamily"
                Value="{StaticResource AppFontFamily}" />
        <Setter Property="BackgroundColor"
                Value="{StaticResource TextBoxBackground}" />
        <Setter Property="TextColor"
                Value="{StaticResource TextPrimary}" />
        <Style.Triggers>
            <Trigger TargetType="TimePicker" Property="FontAttributes" Value="Bold">
                <Setter Property="FontFamily"
                        Value="{StaticResource AppFontFamilyBold}" />
            </Trigger>
        </Style.Triggers>
    </Style>

    <Style x:Key="TitleLabel"
           TargetType="Label">
        <Setter Property="FontFamily"
                Value="{StaticResource AppFontFamily}" />
        <Setter Property="TextColor"
                Value="{StaticResource TextPrimary}" />
        <Setter Property="FontSize"
                Value="32" />
        <Setter Property="FontAttributes"
                Value="Bold" />
        <Style.Triggers>
            <Trigger TargetType="Label" Property="FontAttributes" Value="Bold">
                <Setter Property="FontFamily"
                        Value="{StaticResource AppFontFamilyBold}" />
            </Trigger>
        </Style.Triggers>
    </Style>

    <Style x:Key="SubtitleLabel"
           TargetType="Label">
        <Setter Property="FontFamily"
                Value="{StaticResource AppFontFamily}" />
        <Setter Property="TextColor"
                Value="{StaticResource TextSecondary}" />
        <Setter Property="FontSize"
                Value="16" />
        <Style.Triggers>
            <Trigger TargetType="Label" Property="FontAttributes" Value="Bold">
                <Setter Property="FontFamily"
                        Value="{StaticResource AppFontFamilyBold}" />
            </Trigger>
        </Style.Triggers>
    </Style>

    <Style x:Key="CaptionLabel"
       TargetType="Label">
        <Setter Property="FontFamily"
                Value="{StaticResource AppFontFamily}" />

        <Setter Property="TextColor"
            Value="{StaticResource TextMuted}" />

        <Setter Property="FontSize"
            Value="13" />

        <Style.Triggers>
            <Trigger TargetType="Label" Property="FontAttributes" Value="Bold">
                <Setter Property="FontFamily"
                        Value="{StaticResource AppFontFamilyBold}" />
            </Trigger>
        </Style.Triggers>
    </Style>

    <Style x:Key="PrimaryButton"
           TargetType="Button">
        <Setter Property="FontFamily"
                Value="{StaticResource AppFontFamily}" />
        <Setter Property="BackgroundColor"
                Value="{StaticResource Primary}" />
        <Setter Property="TextColor"
                Value="{StaticResource TextOnPrimary}" />
        <Setter Property="FontSize"
                Value="15" />
        <Setter Property="FontAttributes"
                Value="Bold" />
        <Setter Property="CornerRadius"
                Value="14" />
        <Setter Property="HeightRequest"
                Value="54" />
        <Style.Triggers>
            <Trigger TargetType="Button" Property="FontAttributes" Value="Bold">
                <Setter Property="FontFamily"
                        Value="{StaticResource AppFontFamilyBold}" />
            </Trigger>
        </Style.Triggers>
    </Style>

    <Style x:Key="FormEntry"
           TargetType="Entry">
        <Setter Property="FontFamily"
                Value="{StaticResource AppFontFamily}" />
        <Setter Property="BackgroundColor"
                Value="{StaticResource Surface}" />
        <Setter Property="TextColor"
                Value="{StaticResource TextPrimary}" />
        <Setter Property="PlaceholderColor"
                Value="{StaticResource TextMuted}" />
        <Setter Property="FontSize"
                Value="15" />
        <Setter Property="HeightRequest"
                Value="52" />
        <Style.Triggers>
            <Trigger TargetType="Entry" Property="FontAttributes" Value="Bold">
                <Setter Property="FontFamily"
                        Value="{StaticResource AppFontFamilyBold}" />
            </Trigger>
        </Style.Triggers>
    </Style>

</ResourceDictionary>
