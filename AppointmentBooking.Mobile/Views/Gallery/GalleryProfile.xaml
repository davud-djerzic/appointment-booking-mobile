<?xml version="1.0" encoding="utf-8" ?>

<ContentPage
    x:Class="AppointmentBooking.Mobile.Views.Gallery.GalleryPage"
    xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
    xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
    BackgroundColor="{StaticResource BrandBackground}"
    Shell.NavBarIsVisible="False"
    SafeAreaEdges="All">

    <Grid
        RowDefinitions="Auto,*"
        Padding="20,18,20,16">

        <!-- HEADER -->
        <Grid
            Grid.Row="0"
            ColumnDefinitions="*,Auto"
            Margin="0,0,0,24">

            <VerticalStackLayout
                Grid.Column="0"
                Spacing="4">

                <Label
                    Text="Galerija"
                    FontSize="28"
                    FontAttributes="Bold"
                    TextColor="{StaticResource TextOnBrandBackground}" />

                <Label
                    Text="Pregled frizura i radova salona"
                    FontSize="14"
                    TextColor="{StaticResource TextOnBrandBackground}"
                    Opacity="0.7" />

            </VerticalStackLayout>

            <Border
                Grid.Column="1"
                WidthRequest="42"
                HeightRequest="42"
                BackgroundColor="{StaticResource QuickBookingPanelBackground}"
                Stroke="{StaticResource PanelBorder}"
                StrokeThickness="1"
                StrokeShape="RoundRectangle 21"
                VerticalOptions="Center">

                <Label
                    Text="📷"
                    FontSize="18"
                    HorizontalOptions="Center"
                    VerticalOptions="Center" />

            </Border>

        </Grid>

        <!-- EMPTY STATE CARD -->
        <Grid
            Grid.Row="1"
            Padding="0,0,0,40"
            HorizontalOptions="Fill"
            VerticalOptions="Center">

            <Border
                BackgroundColor="{StaticResource QuickBookingPanelBackground}"
                Stroke="{StaticResource PanelBorder}"
                StrokeThickness="1"
                StrokeShape="RoundRectangle 24"
                Padding="28,36"
                HorizontalOptions="Center"
                VerticalOptions="Center"
                MaximumWidthRequest="380">

                <VerticalStackLayout
                    Spacing="16"
                    HorizontalOptions="Center">

                    <!-- ICON BADGE -->
                    <Border
                        WidthRequest="80"
                        HeightRequest="80"
                        BackgroundColor="{StaticResource BrandBackground}"
                        Stroke="{StaticResource PanelBorder}"
                        StrokeThickness="1.2"
                        StrokeShape="RoundRectangle 40"
                        HorizontalOptions="Center">

                        <Label
                            Text="🖼️"
                            FontSize="36"
                            HorizontalOptions="Center"
                            VerticalOptions="Center" />

                    </Border>

                    <!-- TITLE -->
                    <Label
                        Text="Slike će uskoro biti dostupne"
                        FontSize="20"
                        FontAttributes="Bold"
                        TextColor="{StaticResource TextOnBrandBackground}"
                        HorizontalTextAlignment="Center"
                        Margin="0,4,0,0" />

                    <!-- DESCRIPTION -->
                    <Label
                        Text="Pripremamo galeriju fotografija i najnovijih radova našeg tima. Hvala vam na strpljenju!"
                        FontSize="14"
                        TextColor="{StaticResource TextOnBrandBackground}"
                        Opacity="0.75"
                        HorizontalTextAlignment="Center"
                        LineHeight="1.2" />

                    <!-- STATUS BADGE -->
                    <Border
                        BackgroundColor="{StaticResource BrandBackground}"
                        Stroke="{StaticResource PanelBorder}"
                        StrokeThickness="1"
                        StrokeShape="RoundRectangle 16"
                        Padding="16,8"
                        HorizontalOptions="Center"
                        Margin="0,8,0,0">

                        <HorizontalStackLayout
                            Spacing="8"
                            VerticalOptions="Center">

                            <Label
                                Text="⏱"
                                FontSize="13"
                                TextColor="{StaticResource BrandButton}"
                                VerticalOptions="Center" />

                            <Label
                                Text="U pripremi"
                                FontSize="13"
                                FontAttributes="Bold"
                                TextColor="{StaticResource BrandButton}"
                                VerticalOptions="Center" />

                        </HorizontalStackLayout>

                    </Border>

                </VerticalStackLayout>

            </Border>

        </Grid>

    </Grid>

</ContentPage>
