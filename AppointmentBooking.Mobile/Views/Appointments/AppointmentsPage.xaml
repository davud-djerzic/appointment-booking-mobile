<?xml version="1.0" encoding="utf-8" ?>

<ContentPage
    x:Class="AppointmentBooking.Mobile.Views.Appointments.AppointmentsPage"
    xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
    xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
    xmlns:viewmodels="clr-namespace:AppointmentBooking.Mobile.ViewModels.Appointment"
    xmlns:models="clr-namespace:AppointmentBooking.Mobile.Models.Bookings.Responses"
    x:DataType="viewmodels:AppointmentViewModel"
    BackgroundColor="{StaticResource BrandBackground}"
    Shell.NavBarIsVisible="False"
    SafeAreaEdges="All">

    <Grid RowDefinitions="Auto,Auto,*">

        <!-- HEADER -->
        <Grid
            Grid.Row="0"
            Padding="20,20,20,10"
            ColumnDefinitions="*,Auto">

            <Label
                Grid.Column="0"
                Text="Termini"
                FontSize="28"
                FontAttributes="Bold"
                TextColor="{StaticResource TextOnBrandBackground}"
                VerticalOptions="Center" />

            <ActivityIndicator
                Grid.Column="1"
                IsRunning="{Binding IsLoading}"
                IsVisible="{Binding IsLoading}"
                Color="{StaticResource BrandButton}"
                HeightRequest="24"
                WidthRequest="24"
                VerticalOptions="Center" />

        </Grid>


        <!-- TABS -->
        <Border
            Grid.Row="1"
            Margin="20,5,20,15"
            Padding="4"
            BackgroundColor="{StaticResource QuickBookingPanelBackground}"
            Stroke="{StaticResource PanelBorder}"
            StrokeThickness="0.8"
            StrokeShape="RoundRectangle 14">

            <Grid ColumnDefinitions="*,*,*">

                <!-- PREDSTOJEĆI -->
                <Border
                    x:Name="UpcomingTab"
                    Grid.Column="0"
                    Padding="10,9"
                    BackgroundColor="{StaticResource BrandButton}"
                    StrokeThickness="0"
                    StrokeShape="RoundRectangle 10">

                    <Border.GestureRecognizers>
                        <TapGestureRecognizer Tapped="OnUpcomingTabTapped" />
                    </Border.GestureRecognizers>

                    <Label
                        Text="Predstojeći"
                        FontSize="14"
                        FontAttributes="Bold"
                        TextColor="{StaticResource BrandBackground}"
                        HorizontalTextAlignment="Center"
                        VerticalTextAlignment="Center" />

                </Border>


                <!-- PRETHODNI -->
                <Border
                    x:Name="PreviousTab"
                    Grid.Column="1"
                    Padding="10,9"
                    BackgroundColor="Transparent"
                    StrokeThickness="0"
                    StrokeShape="RoundRectangle 10">

                    <Border.GestureRecognizers>
                        <TapGestureRecognizer Tapped="OnPreviousTabTapped" />
                    </Border.GestureRecognizers>

                    <Label
                        Text="Prethodni"
                        FontSize="14"
                        FontAttributes="Bold"
                        TextColor="{StaticResource TextOnBrandBackground}"
                        Opacity="0.7"
                        HorizontalTextAlignment="Center"
                        VerticalTextAlignment="Center" />

                </Border>


                <!-- OTKAZANI -->
                <Border
                    x:Name="CancelledTab"
                    Grid.Column="2"
                    Padding="10,9"
                    BackgroundColor="Transparent"
                    StrokeThickness="0"
                    StrokeShape="RoundRectangle 10">

                    <Border.GestureRecognizers>
                        <TapGestureRecognizer Tapped="OnCancelledTabTapped" />
                    </Border.GestureRecognizers>

                    <Label
                        Text="Otkazani"
                        FontSize="14"
                        FontAttributes="Bold"
                        TextColor="{StaticResource TextOnBrandBackground}"
                        Opacity="0.7"
                        HorizontalTextAlignment="Center"
                        VerticalTextAlignment="Center" />

                </Border>

            </Grid>

        </Border>


        <!-- CONTENT -->
        <Grid
            Grid.Row="2"
            Padding="20,0">


            <!-- ===================================================== -->
            <!-- PREDSTOJEĆI TERMINI -->
            <!-- ===================================================== -->

            <CollectionView
                x:Name="UpcomingCollection"
                ItemsSource="{Binding UpcomingAppointments}"
                SelectionMode="None"
                IsVisible="True">

                <CollectionView.EmptyView>

                    <VerticalStackLayout
                        Spacing="8"
                        HorizontalOptions="Center"
                        VerticalOptions="Center">

                        <Label
                            Text="Nemate predstojećih termina."
                            FontSize="17"
                            FontAttributes="Bold"
                            TextColor="{StaticResource TextOnBrandBackground}"
                            HorizontalTextAlignment="Center" />

                        <Label
                            Text="Vaši zakazani termini će se prikazati ovdje."
                            FontSize="14"
                            TextColor="{StaticResource TextOnBrandBackground}"
                            HorizontalTextAlignment="Center" />

                    </VerticalStackLayout>

                </CollectionView.EmptyView>


                <CollectionView.ItemTemplate>

                    <DataTemplate x:DataType="models:BookingSummaryResponse">

                        <!-- RAZMAK IZMEĐU TERMINA -->
                        <Grid Padding="0,0,0,16">

                            <Border
                                Padding="18"
                                BackgroundColor="{StaticResource QuickBookingPanelBackground}"
                                Stroke="{StaticResource PanelBorder}"
                                StrokeThickness="0.8"
                                StrokeShape="RoundRectangle 18">

                                <VerticalStackLayout Spacing="12">

                                    <!-- DATUM -->
                                    <Label
                                        Text="{Binding LocalStartsAt, StringFormat='{}{0:dd.MM.yyyy.}'}"
                                        FontSize="20"
                                        FontAttributes="Bold"
                                        TextColor="{StaticResource TextOnBrandBackground}" />

                                    <!-- VRIJEME -->
                                    <Grid
                                        ColumnDefinitions="Auto,Auto,Auto"
                                        ColumnSpacing="6">

                                        <Label
                                            Grid.Column="0"
                                            Text="{Binding LocalStartsAt, StringFormat='{}{0:HH:mm}'}"
                                            FontSize="17"
                                            FontAttributes="Bold"
                                            TextColor="{StaticResource BrandButton}" />

                                        <Label
                                            Grid.Column="1"
                                            Text="-"
                                            FontSize="17"
                                            FontAttributes="Bold"
                                            TextColor="{StaticResource BrandButton}" />

                                        <Label
                                            Grid.Column="2"
                                            Text="{Binding LocalEndsAt, StringFormat='{}{0:HH:mm}'}"
                                            FontSize="17"
                                            FontAttributes="Bold"
                                            TextColor="{StaticResource BrandButton}" />

                                    </Grid>


                                    <BoxView
                                        HeightRequest="0.8"
                                        Color="{StaticResource PanelBorder}" />


                                    <!-- FRIZER -->
                                    <Grid ColumnDefinitions="Auto,*">

                                        <Label
                                            Grid.Column="0"
                                            Text="Frizer:"
                                            FontSize="14"
                                            TextColor="{StaticResource TextOnBrandBackground}"
                                            Opacity="0.7" />

                                        <Label
                                            Grid.Column="1"
                                            Margin="8,0,0,0"
                                            Text="{Binding Employee.FirstName}"
                                            FontSize="15"
                                            FontAttributes="Bold"
                                            TextColor="{StaticResource TextOnBrandBackground}" />

                                    </Grid>


                                    <!-- TRAJANJE -->
                                    <Grid ColumnDefinitions="Auto,*">

                                        <Label
                                            Grid.Column="0"
                                            Text="Trajanje:"
                                            FontSize="14"
                                            TextColor="{StaticResource TextOnBrandBackground}"
                                            Opacity="0.7" />

                                        <Label
                                            Grid.Column="1"
                                            Margin="8,0,0,0"
                                            Text="{Binding TotalDurationMinutes, StringFormat='{}{0} minuta'}"
                                            FontSize="15"
                                            TextColor="{StaticResource TextOnBrandBackground}" />

                                    </Grid>


                                    <!-- CIJENA -->
                                    <Grid ColumnDefinitions="Auto,*">

                                        <Label
                                            Grid.Column="0"
                                            Text="Cijena:"
                                            FontSize="14"
                                            TextColor="{StaticResource TextOnBrandBackground}"
                                            Opacity="0.7" />

                                        <Label
                                            Grid.Column="1"
                                            Margin="8,0,0,0"
                                            Text="{Binding TotalPrice, StringFormat='{}{0:F2} KM'}"
                                            FontSize="16"
                                            FontAttributes="Bold"
                                            TextColor="{StaticResource BrandButton}" />

                                    </Grid>


                                    <Grid
                                        ColumnDefinitions="*,*"
                                        ColumnSpacing="10"
                                        Margin="0,6,0,0">

                                        <Button
                                            Grid.Column="0"
                                            Text="Otkaži"
                                            FontSize="14"
                                            FontAttributes="Bold"
                                            TextColor="{StaticResource Error}"
                                            BackgroundColor="{StaticResource QuickBookingPanelBackground}"
                                            BorderColor="{StaticResource Error}"
                                            BorderWidth="1"
                                            CornerRadius="12"
                                            HeightRequest="44"
                                            Clicked="OnCancelClicked"
                                            CommandParameter="{Binding .}" />

                                        <Button
                                            Grid.Column="1"
                                            Text="Detalji termina"
                                            FontSize="14"
                                            FontAttributes="Bold"
                                            TextColor="{StaticResource BrandBackground}"
                                            BackgroundColor="{StaticResource BrandButton}"
                                            CornerRadius="12"
                                            HeightRequest="44"
                                            Clicked="OnDetailsClicked"
                                            CommandParameter="{Binding .}" />

                                    </Grid>

                                </VerticalStackLayout>

                            </Border>

                        </Grid>

                    </DataTemplate>

                </CollectionView.ItemTemplate>

            </CollectionView>



            <!-- ===================================================== -->
            <!-- PRETHODNI TERMINI -->
            <!-- ===================================================== -->

            <CollectionView
                x:Name="PreviousCollection"
                ItemsSource="{Binding PreviousAppointments}"
                SelectionMode="None"
                IsVisible="False">

                <CollectionView.EmptyView>

                    <VerticalStackLayout
                        Spacing="8"
                        HorizontalOptions="Center"
                        VerticalOptions="Center">

                        <Label
                            Text="Nemate prethodnih termina."
                            FontSize="17"
                            FontAttributes="Bold"
                            TextColor="{StaticResource TextOnBrandBackground}"
                            HorizontalTextAlignment="Center" />

                        <Label
                            Text="Vaši završeni termini će se prikazati ovdje."
                            FontSize="14"
                            TextColor="{StaticResource TextOnBrandBackground}"
                            HorizontalTextAlignment="Center" />

                    </VerticalStackLayout>

                </CollectionView.EmptyView>


                <CollectionView.ItemTemplate>

                    <DataTemplate x:DataType="models:BookingSummaryResponse">

                        <!-- RAZMAK IZMEĐU TERMINA -->
                        <Grid Padding="0,0,0,16">

                            <Border
                                Padding="18"
                                BackgroundColor="{StaticResource QuickBookingPanelBackground}"
                                Stroke="{StaticResource PanelBorder}"
                                StrokeThickness="0.8"
                                StrokeShape="RoundRectangle 18">

                                <VerticalStackLayout Spacing="12">

                                    <!-- DATUM -->
                                    <Label
                                        Text="{Binding LocalStartsAt, StringFormat='{}{0:dd.MM.yyyy.}'}"
                                        FontSize="20"
                                        FontAttributes="Bold"
                                        TextColor="{StaticResource TextOnBrandBackground}" />

                                    <!-- VRIJEME -->
                                    <Grid
                                        ColumnDefinitions="Auto,Auto,Auto"
                                        ColumnSpacing="6">

                                        <Label
                                            Grid.Column="0"
                                            Text="{Binding LocalStartsAt, StringFormat='{}{0:HH:mm}'}"
                                            FontSize="17"
                                            FontAttributes="Bold"
                                            TextColor="{StaticResource TextOnBrandBackground}"
                                            Opacity="0.85" />

                                        <Label
                                            Grid.Column="1"
                                            Text="-"
                                            FontSize="17"
                                            FontAttributes="Bold"
                                            TextColor="{StaticResource TextOnBrandBackground}"
                                            Opacity="0.85" />

                                        <Label
                                            Grid.Column="2"
                                            Text="{Binding LocalEndsAt, StringFormat='{}{0:HH:mm}'}"
                                            FontSize="17"
                                            FontAttributes="Bold"
                                            TextColor="{StaticResource TextOnBrandBackground}"
                                            Opacity="0.85" />

                                    </Grid>


                                    <BoxView
                                        HeightRequest="0.8"
                                        Color="{StaticResource PanelBorder}" />


                                    <!-- FRIZER -->
                                    <Grid ColumnDefinitions="Auto,*">

                                        <Label
                                            Text="Frizer:"
                                            FontSize="14"
                                            TextColor="{StaticResource TextOnBrandBackground}"
                                            Opacity="0.7" />

                                        <Label
                                            Grid.Column="1"
                                            Margin="8,0,0,0"
                                            Text="{Binding Employee.FirstName}"
                                            FontSize="15"
                                            FontAttributes="Bold"
                                            TextColor="{StaticResource TextOnBrandBackground}" />

                                    </Grid>


                                    <!-- TRAJANJE -->
                                    <Grid ColumnDefinitions="Auto,*">

                                        <Label
                                            Text="Trajanje:"
                                            FontSize="14"
                                            TextColor="{StaticResource TextOnBrandBackground}"
                                            Opacity="0.7" />

                                        <Label
                                            Grid.Column="1"
                                            Margin="8,0,0,0"
                                            Text="{Binding TotalDurationMinutes, StringFormat='{}{0} minuta'}"
                                            FontSize="15"
                                            TextColor="{StaticResource TextOnBrandBackground}" />

                                    </Grid>


                                    <!-- CIJENA -->
                                    <Grid ColumnDefinitions="Auto,*">

                                        <Label
                                            Grid.Column="0"
                                            Text="Cijena:"
                                            FontSize="14"
                                            TextColor="{StaticResource TextOnBrandBackground}"
                                            Opacity="0.7" />

                                        <Label
                                            Grid.Column="1"
                                            Margin="8,0,0,0"
                                            Text="{Binding TotalPrice, StringFormat='{}{0:F2} KM'}"
                                            FontSize="16"
                                            FontAttributes="Bold"
                                            TextColor="{StaticResource BrandButton}" />

                                    </Grid>


                                    <!-- DETALJI -->
                                    <Button
                                        Text="Detalji termina"
                                        FontSize="14"
                                        FontAttributes="Bold"
                                        TextColor="{StaticResource TextOnBrandBackground}"
                                        BackgroundColor="{StaticResource QuickBookingPanelBackground}"
                                        BorderColor="{StaticResource PanelBorder}"
                                        BorderWidth="1"
                                        CornerRadius="12"
                                        HeightRequest="44"
                                        Margin="0,6,0,0"
                                        Clicked="OnDetailsClicked"
                                        CommandParameter="{Binding .}" />

                                </VerticalStackLayout>

                            </Border>

                        </Grid>

                    </DataTemplate>

                </CollectionView.ItemTemplate>

            </CollectionView>



            <!-- ===================================================== -->
            <!-- OTKAZANI TERMINI -->
            <!-- ===================================================== -->

            <CollectionView
                x:Name="CancelledCollection"
                ItemsSource="{Binding CancelledAppointments}"
                SelectionMode="None"
                IsVisible="False">

                <CollectionView.EmptyView>

                    <VerticalStackLayout
                        Spacing="8"
                        HorizontalOptions="Center"
                        VerticalOptions="Center">

                        <Label
                            Text="Nemate otkazanih termina."
                            FontSize="17"
                            FontAttributes="Bold"
                            TextColor="{StaticResource TextOnBrandBackground}"
                            HorizontalTextAlignment="Center" />

                        <Label
                            Text="Vaši otkazani termini će se prikazati ovdje."
                            FontSize="14"
                            TextColor="{StaticResource TextOnBrandBackground}"
                            HorizontalTextAlignment="Center" />

                    </VerticalStackLayout>

                </CollectionView.EmptyView>


                <CollectionView.ItemTemplate>

                    <DataTemplate x:DataType="models:BookingSummaryResponse">

                        <!-- RAZMAK IZMEĐU TERMINA -->
                        <Grid Padding="0,0,0,16">

                            <Border
                                Padding="18"
                                BackgroundColor="{StaticResource QuickBookingPanelBackground}"
                                Stroke="{StaticResource PanelBorder}"
                                StrokeThickness="0.8"
                                StrokeShape="RoundRectangle 18"
                                Opacity="0.85">

                                <VerticalStackLayout Spacing="12">

                                    <!-- DATUM -->
                                    <Label
                                        Text="{Binding LocalStartsAt, StringFormat='{}{0:dd.MM.yyyy.}'}"
                                        FontSize="20"
                                        FontAttributes="Bold"
                                        TextColor="{StaticResource TextOnBrandBackground}" />

                                    <!-- VRIJEME -->
                                    <Grid
                                        ColumnDefinitions="Auto,Auto,Auto"
                                        ColumnSpacing="6">

                                        <Label
                                            Grid.Column="0"
                                            Text="{Binding LocalStartsAt, StringFormat='{}{0:HH:mm}'}"
                                            FontSize="17"
                                            TextColor="{StaticResource TextOnBrandBackground}"
                                            Opacity="0.6" />

                                        <Label
                                            Grid.Column="1"
                                            Text="-"
                                            FontSize="17"
                                            TextColor="{StaticResource TextOnBrandBackground}"
                                            Opacity="0.6" />

                                        <Label
                                            Grid.Column="2"
                                            Text="{Binding LocalEndsAt, StringFormat='{}{0:HH:mm}'}"
                                            FontSize="17"
                                            TextColor="{StaticResource TextOnBrandBackground}"
                                            Opacity="0.6" />

                                    </Grid>


                                    <BoxView
                                        HeightRequest="0.8"
                                        Color="{StaticResource PanelBorder}" />


                                    <!-- FRIZER -->
                                    <Grid ColumnDefinitions="Auto,*">

                                        <Label
                                            Grid.Column="0"
                                            Text="Frizer:"
                                            FontSize="14"
                                            TextColor="{StaticResource TextOnBrandBackground}"
                                            Opacity="0.7" />

                                        <Label
                                            Grid.Column="1"
                                            Margin="8,0,0,0"
                                            Text="{Binding Employee.FirstName}"
                                            FontSize="15"
                                            FontAttributes="Bold"
                                            TextColor="{StaticResource TextOnBrandBackground}" />

                                    </Grid>


                                    <!-- TRAJANJE -->
                                    <Grid ColumnDefinitions="Auto,*">

                                        <Label
                                            Grid.Column="0"
                                            Text="Trajanje:"
                                            FontSize="14"
                                            TextColor="{StaticResource TextOnBrandBackground}"
                                            Opacity="0.7" />

                                        <Label
                                            Grid.Column="1"
                                            Margin="8,0,0,0"
                                            Text="{Binding TotalDurationMinutes, StringFormat='{}{0} minuta'}"
                                            FontSize="15"
                                            TextColor="{StaticResource TextOnBrandBackground}" />

                                    </Grid>


                                    <!-- CIJENA -->
                                    <Grid ColumnDefinitions="Auto,*">

                                        <Label
                                            Grid.Column="0"
                                            Text="Cijena:"
                                            FontSize="14"
                                            TextColor="{StaticResource TextOnBrandBackground}"
                                            Opacity="0.7" />

                                        <Label
                                            Grid.Column="1"
                                            Margin="8,0,0,0"
                                            Text="{Binding TotalPrice, StringFormat='{}{0:F2} KM'}"
                                            FontSize="16"
                                            FontAttributes="Bold"
                                            TextColor="{StaticResource BrandButton}" />

                                    </Grid>


                                    <!-- STATUS -->
                                    <Label
                                        Text="Termin je otkazan"
                                        FontSize="14"
                                        FontAttributes="Bold"
                                        TextColor="{StaticResource Error}"
                                        Margin="0,4,0,0" />


                                    <!-- DETALJI -->
                                    <Button
                                        Text="Detalji termina"
                                        FontSize="14"
                                        FontAttributes="Bold"
                                        TextColor="{StaticResource TextOnBrandBackground}"
                                        BackgroundColor="{StaticResource QuickBookingPanelBackground}"
                                        BorderColor="{StaticResource PanelBorder}"
                                        BorderWidth="1"
                                        CornerRadius="12"
                                        HeightRequest="44"
                                        Margin="0,6,0,0"
                                        Clicked="OnDetailsClicked"
                                        CommandParameter="{Binding .}" />

                                </VerticalStackLayout>

                            </Border>

                        </Grid>

                    </DataTemplate>

                </CollectionView.ItemTemplate>

            </CollectionView>

        </Grid>

    </Grid>

</ContentPage>
