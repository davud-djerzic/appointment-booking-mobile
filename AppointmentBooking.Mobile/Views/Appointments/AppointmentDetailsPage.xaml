<?xml version="1.0" encoding="utf-8" ?>

<ContentPage
    x:Class="AppointmentBooking.Mobile.Views.Appointments.AppointmentDetailsPage"
    xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
    xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
    xmlns:models="clr-namespace:AppointmentBooking.Mobile.Models.Bookings.Responses"
    xmlns:appointmentModels="clr-namespace:AppointmentBooking.Mobile.Models.Appointments.Responses"
    x:DataType="models:BookingDetailsResponse"
    BackgroundColor="{StaticResource BrandBackground}"
    Shell.NavBarIsVisible="False"
    SafeAreaEdges="All">

    <Grid Padding="24">

        <!-- MODAL CARD -->
        <Border
            BackgroundColor="{StaticResource QuickBookingPanelBackground}"
            Stroke="{StaticResource PanelBorder}"
            StrokeThickness="1"
            StrokeShape="RoundRectangle 24"
            Padding="22"
            HorizontalOptions="Center"
            VerticalOptions="Center"
            MaximumWidthRequest="430">

            <Grid RowDefinitions="Auto,*,Auto">

                <!-- HEADER -->
                <Grid
                    Grid.Row="0"
                    ColumnDefinitions="*,Auto"
                    Margin="0,0,0,20">

                    <VerticalStackLayout
                        Grid.Column="0"
                        Spacing="4">

                        <Label
                            Text="Detalji termina"
                            FontSize="24"
                            FontAttributes="Bold"
                            TextColor="{StaticResource TextOnBrandBackground}" />

                        <Label
                            Text="Pregled informacija o rezervaciji"
                            FontSize="13"
                            TextColor="{StaticResource TextOnBrandBackground}"
                            Opacity="0.7" />

                    </VerticalStackLayout>

                    <Button
                        Grid.Column="1"
                        Text="✕"
                        FontSize="16"
                        FontAttributes="Bold"
                        TextColor="{StaticResource TextOnBrandBackground}"
                        BackgroundColor="{StaticResource BrandBackground}"
                        BorderColor="{StaticResource PanelBorder}"
                        BorderWidth="1"
                        CornerRadius="21"
                        WidthRequest="42"
                        HeightRequest="42"
                        Padding="0"
                        Clicked="OnCloseClicked" />

                </Grid>

                <!-- CONTENT -->
                <ScrollView Grid.Row="1">

                    <VerticalStackLayout Spacing="16">

                        <!-- DATUM I VRIJEME -->
                        <Border
                            BackgroundColor="{StaticResource BrandBackground}"
                            Stroke="{StaticResource PanelBorder}"
                            StrokeThickness="0.8"
                            StrokeShape="RoundRectangle 16"
                            Padding="16">

                            <VerticalStackLayout Spacing="10">

                                <Label
                                    Text="Datum i vrijeme"
                                    FontSize="13"
                                    TextColor="{StaticResource TextOnBrandBackground}"
                                    Opacity="0.7" />

                                <Label
                                    Text="{Binding LocalStartsAt, StringFormat='{}{0:dd.MM.yyyy.}'}"
                                    FontSize="20"
                                    FontAttributes="Bold"
                                    TextColor="{StaticResource TextOnBrandBackground}" />

                                <Grid
                                    ColumnDefinitions="Auto,Auto,Auto"
                                    ColumnSpacing="6">

                                    <Label
                                        Grid.Column="0"
                                        Text="{Binding LocalStartsAt, StringFormat='{}{0:HH:mm}'}"
                                        FontSize="18"
                                        FontAttributes="Bold"
                                        TextColor="{StaticResource BrandButton}" />

                                    <Label
                                        Grid.Column="1"
                                        Text="-"
                                        FontSize="18"
                                        FontAttributes="Bold"
                                        TextColor="{StaticResource BrandButton}" />

                                    <Label
                                        Grid.Column="2"
                                        Text="{Binding LocalEndsAt, StringFormat='{}{0:HH:mm}'}"
                                        FontSize="18"
                                        FontAttributes="Bold"
                                        TextColor="{StaticResource BrandButton}" />

                                </Grid>

                            </VerticalStackLayout>

                        </Border>

                        <!-- FRIZER -->
                        <Border
                            BackgroundColor="{StaticResource BrandBackground}"
                            Stroke="{StaticResource PanelBorder}"
                            StrokeThickness="0.8"
                            StrokeShape="RoundRectangle 16"
                            Padding="16">

                            <Grid ColumnDefinitions="Auto,*">

                                <VerticalStackLayout
                                    Grid.Column="0"
                                    Spacing="3">

                                    <Label
                                        Text="Frizer"
                                        FontSize="13"
                                        TextColor="{StaticResource TextOnBrandBackground}"
                                        Opacity="0.7" />

                                    <Label
                                        Text="Osoba zadužena za termin"
                                        FontSize="11"
                                        TextColor="{StaticResource TextOnBrandBackground}"
                                        Opacity="0.5" />

                                </VerticalStackLayout>

                                <Label
                                    Grid.Column="1"
                                    Text="{Binding EmployeeName}"
                                    FontSize="16"
                                    FontAttributes="Bold"
                                    TextColor="{StaticResource BrandButton}"
                                    HorizontalOptions="End"
                                    VerticalOptions="Center" />

                            </Grid>

                        </Border>

                        <!-- USLUGE -->
                        <VerticalStackLayout Spacing="10">

                            <Label
                                Text="Usluge"
                                FontSize="18"
                                FontAttributes="Bold"
                                TextColor="{StaticResource TextOnBrandBackground}" />

                            <CollectionView
                                ItemsSource="{Binding Appointments}"
                                SelectionMode="None">

                                <CollectionView.ItemTemplate>
                                    <DataTemplate x:DataType="appointmentModels:AppointmentResponse">

                                        <Border
                                            BackgroundColor="{StaticResource BrandBackground}"
                                            Stroke="{StaticResource PanelBorder}"
                                            StrokeThickness="0.8"
                                            StrokeShape="RoundRectangle 14"
                                            Padding="14"
                                            Margin="0,0,0,8">

                                            <Grid
                                                ColumnDefinitions="*,Auto"
                                                RowDefinitions="Auto,Auto">

                                                <Label
                                                    Grid.Row="0"
                                                    Text="{Binding ServiceName}"
                                                    FontSize="15"
                                                    FontAttributes="Bold"
                                                    TextColor="{StaticResource TextOnBrandBackground}" />

                                                <Label
                                                    Grid.Row="1"
                                                    Text="{Binding DurationMinutes, StringFormat='{}{0} minuta'}"
                                                    FontSize="12"
                                                    TextColor="{StaticResource TextOnBrandBackground}"
                                                    Opacity="0.7" />

                                                <Label
                                                    Grid.RowSpan="2"
                                                    Grid.Column="1"
                                                    Text="{Binding Price, StringFormat='{}{0:F2} KM'}"
                                                    FontSize="15"
                                                    FontAttributes="Bold"
                                                    TextColor="{StaticResource BrandButton}"
                                                    VerticalOptions="Center" />

                                            </Grid>

                                        </Border>

                                    </DataTemplate>
                                </CollectionView.ItemTemplate>

                            </CollectionView>

                        </VerticalStackLayout>

                        <!-- UKUPNO -->
                        <Border
                            BackgroundColor="{StaticResource BrandButton}"
                            StrokeThickness="0"
                            StrokeShape="RoundRectangle 16"
                            Padding="16">

                            <Grid ColumnDefinitions="*,Auto">

                                <VerticalStackLayout
                                    Grid.Column="0"
                                    Spacing="3">

                                    <Label
                                        Text="Ukupno"
                                        FontSize="14"
                                        FontAttributes="Bold"
                                        TextColor="{StaticResource BrandBackground}" />

                                    <Label
                                        Text="{Binding TotalDurationMinutes, StringFormat='{}{0} minuta'}"
                                        FontSize="12"
                                        TextColor="{StaticResource BrandBackground}"
                                        Opacity="0.8" />

                                </VerticalStackLayout>

                                <Label
                                    Grid.Column="1"
                                    Text="{Binding TotalPrice, StringFormat='{}{0:F2} KM'}"
                                    FontSize="20"
                                    FontAttributes="Bold"
                                    TextColor="{StaticResource BrandBackground}"
                                    VerticalOptions="Center" />

                            </Grid>

                        </Border>

                        <!-- STATUS -->
                        <Grid ColumnDefinitions="Auto,*">

                            <Label
                                Grid.Column="0"
                                Text="Status:"
                                FontSize="14"
                                TextColor="{StaticResource TextOnBrandBackground}"
                                Opacity="0.7" />

                            <Label
                                Grid.Column="1"
                                Text="{Binding StatusName}"
                                FontSize="14"
                                FontAttributes="Bold"
                                TextColor="{StaticResource BrandButton}"
                                HorizontalOptions="End" />

                        </Grid>

                        <!-- NAPOMENA -->
                        <VerticalStackLayout
                            Spacing="5"
                            IsVisible="{Binding Notes}">

                            <Label
                                Text="Napomena"
                                FontSize="14"
                                FontAttributes="Bold"
                                TextColor="{StaticResource TextOnBrandBackground}" />

                            <Label
                                Text="{Binding Notes}"
                                FontSize="13"
                                TextColor="{StaticResource TextOnBrandBackground}"
                                Opacity="0.8" />

                        </VerticalStackLayout>

                    </VerticalStackLayout>

                </ScrollView>

                <!-- CLOSE -->
                <Button
                    Grid.Row="2"
                    Text="Zatvori"
                    FontSize="15"
                    FontAttributes="Bold"
                    TextColor="{StaticResource BrandBackground}"
                    BackgroundColor="{StaticResource BrandButton}"
                    CornerRadius="14"
                    HeightRequest="48"
                    Margin="0,18,0,0"
                    Clicked="OnCloseClicked" />

            </Grid>

        </Border>

        <!-- LOADING -->
        <ActivityIndicator
            x:Name="LoadingIndicator"
            IsRunning="False"
            IsVisible="False"
            Color="{StaticResource BrandButton}"
            WidthRequest="45"
            HeightRequest="45"
            HorizontalOptions="Center"
            VerticalOptions="Center" />

    </Grid>

</ContentPage>
