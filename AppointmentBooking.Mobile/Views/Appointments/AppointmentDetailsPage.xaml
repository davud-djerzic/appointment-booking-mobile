<?xml version="1.0" encoding="utf-8" ?>

<ContentPage
    x:Class="AppointmentBooking.Mobile.Views.Appointments.AppointmentDetailsPage"
    xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
    xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
    xmlns:bookingModels="clr-namespace:AppointmentBooking.Mobile.Models.Bookings.Responses"
    xmlns:appointmentModels="clr-namespace:AppointmentBooking.Mobile.Models.Appointments.Responses"
    x:DataType="bookingModels:BookingDetailsResponse"
    BackgroundColor="{StaticResource BrandBackground}"
    Shell.NavBarIsVisible="False"
    SafeAreaEdges="All">

    <ContentPage.Resources>
        <Style x:Key="SectionCaption" TargetType="Label">
            <Setter Property="FontFamily" Value="{StaticResource AppFontFamilyBold}" />
            <Setter Property="FontAttributes" Value="Bold" />
            <Setter Property="FontSize" Value="11" />
            <Setter Property="CharacterSpacing" Value="1" />
            <Setter Property="TextColor" Value="{StaticResource TextOnBrandBackground}" />
            <Setter Property="Opacity" Value="0.6" />
        </Style>

        <Style x:Key="SectionCard" TargetType="Border">
            <Setter Property="BackgroundColor" Value="{StaticResource BrandBackground}" />
            <Setter Property="Stroke" Value="{StaticResource PanelBorder}" />
            <Setter Property="StrokeThickness" Value="0.8" />
            <Setter Property="StrokeShape" Value="RoundRectangle 18" />
            <Setter Property="Padding" Value="16" />
        </Style>

        <Style x:Key="InfoChip" TargetType="Border">
            <Setter Property="BackgroundColor" Value="{StaticResource QuickBookingPanelBackground}" />
            <Setter Property="Stroke" Value="{StaticResource PanelBorder}" />
            <Setter Property="StrokeThickness" Value="0.8" />
            <Setter Property="StrokeShape" Value="RoundRectangle 10" />
            <Setter Property="Padding" Value="10,6" />
        </Style>
    </ContentPage.Resources>

    <Grid Padding="16">

        <Border
            BackgroundColor="{StaticResource QuickBookingPanelBackground}"
            Stroke="{StaticResource PanelBorder}"
            StrokeThickness="1"
            StrokeShape="RoundRectangle 24"
            HorizontalOptions="Center"
            VerticalOptions="Center"
            MaximumWidthRequest="480"
            MaximumHeightRequest="860">

            <Grid RowDefinitions="Auto,*,Auto">

                <!-- Header -->
                <Grid
                    Grid.Row="0"
                    Padding="22,20,16,12"
                    ColumnDefinitions="*,Auto"
                    ColumnSpacing="12">

                    <VerticalStackLayout Spacing="4" VerticalOptions="Center">
                        <Label Text="DETALJI TERMINA" Style="{StaticResource SectionCaption}" />
  
                    </VerticalStackLayout>

                    <Button
                        Grid.Column="1"
                        Text="✕"
                        FontSize="16"
                        FontAttributes="Bold"
                        TextColor="{StaticResource TextOnBrandBackground}"
                        BackgroundColor="{StaticResource BrandBackground}"
                        BorderColor="{StaticResource PanelBorder}"
                        BorderWidth="1"
                        WidthRequest="42"
                        HeightRequest="42"
                        CornerRadius="21"
                        Padding="0"
                        VerticalOptions="Start"
                        SemanticProperties.Description="Zatvori"
                        Clicked="OnCloseClicked" />
                </Grid>

                <ScrollView Grid.Row="1">
                    <VerticalStackLayout Padding="20,4,20,16" Spacing="14">

                        <!-- Date, time and status -->
                        <Border Style="{StaticResource SectionCard}" Padding="18">
                            <Grid
                                RowDefinitions="Auto,Auto,Auto"
                                ColumnDefinitions="*,Auto"
                                RowSpacing="8"
                                ColumnSpacing="10">

                                <Label
                                    Text="{Binding StartsAtDateText}"
                                    FontSize="15"
                                    TextColor="{StaticResource TextOnBrandBackground}"
                                    Opacity="0.85"
                                    VerticalOptions="Center" />

                                <Border
                                    Grid.Column="1"
                                    Style="{StaticResource InfoChip}"
                                    VerticalOptions="Center">
                                    <Border.Triggers>
                                        <DataTrigger TargetType="Border" Binding="{Binding IsCancelled}" Value="True">
                                            <Setter Property="Stroke" Value="{StaticResource Error}" />
                                        </DataTrigger>
                                    </Border.Triggers>
                                    <Label
                                        Text="{Binding StatusName}"
                                        FontSize="12"
                                        FontAttributes="Bold"
                                        TextColor="{StaticResource BrandButton}">
                                        <Label.Triggers>
                                            <DataTrigger TargetType="Label" Binding="{Binding IsCancelled}" Value="True">
                                                <Setter Property="TextColor" Value="{StaticResource Error}" />
                                            </DataTrigger>
                                        </Label.Triggers>
                                    </Label>
                                </Border>

                                <Label
                                    Grid.Row="1"
                                    Grid.ColumnSpan="2"
                                    Text="{Binding TimeRangeText}"
                                    FontSize="30"
                                    FontAttributes="Bold"
                                    TextColor="{StaticResource BrandButton}" />

                                <HorizontalStackLayout Grid.Row="2" Grid.ColumnSpan="2" Spacing="8">
                                    <Border Style="{StaticResource InfoChip}">
                                        <Label
                                            Text="{Binding TotalDurationText}"
                                            FontSize="12"
                                            FontAttributes="Bold"
                                            TextColor="{StaticResource TextOnBrandBackground}" />
                                    </Border>
                                    <Border Style="{StaticResource InfoChip}">
                                        <Label
                                            Text="{Binding ServiceCountText}"
                                            FontSize="12"
                                            FontAttributes="Bold"
                                            TextColor="{StaticResource TextOnBrandBackground}" />
                                    </Border>
                                </HorizontalStackLayout>
                            </Grid>
                        </Border>

                        <!-- Employee -->
                        <Border Style="{StaticResource SectionCard}">
                            <Grid ColumnDefinitions="*,Auto" ColumnSpacing="12">
                                <Label
                                    Text="FRIZER"
                                    Style="{StaticResource SectionCaption}"
                                    VerticalOptions="Center" />
                                <Label
                                    Grid.Column="1"
                                    Text="{Binding EmployeeName}"
                                    FontSize="16"
                                    FontAttributes="Bold"
                                    TextColor="{StaticResource TextOnBrandBackground}"
                                    VerticalOptions="Center" />
                            </Grid>
                        </Border>

                        <!-- Services -->
                        <Border Style="{StaticResource SectionCard}">
                            <VerticalStackLayout Spacing="12">
                                <Label Text="USLUGE" Style="{StaticResource SectionCaption}" />

                                <VerticalStackLayout BindableLayout.ItemsSource="{Binding Appointments}" Spacing="8">
                                    <BindableLayout.ItemTemplate>
                                        <DataTemplate x:DataType="appointmentModels:AppointmentResponse">
                                            <Border
                                                BackgroundColor="{StaticResource QuickBookingPanelBackground}"
                                                Stroke="{StaticResource PanelBorder}"
                                                StrokeThickness="0.8"
                                                StrokeShape="RoundRectangle 13"
                                                Padding="14,12">
                                                <Grid ColumnDefinitions="*,Auto" RowDefinitions="Auto,Auto" ColumnSpacing="10" RowSpacing="3">
                                                    <Label
                                                        Text="{Binding ServiceName}"
                                                        FontSize="15"
                                                        FontAttributes="Bold"
                                                        TextColor="{StaticResource TextOnBrandBackground}"
                                                        LineBreakMode="WordWrap" />
                                                    <Label
                                                        Grid.Row="1"
                                                        Text="{Binding DurationText}"
                                                        FontSize="12"
                                                        TextColor="{StaticResource TextOnBrandBackground}"
                                                        Opacity="0.65" />
                                                    <Label
                                                        Grid.RowSpan="2"
                                                        Grid.Column="1"
                                                        Text="{Binding PriceText}"
                                                        FontSize="15"
                                                        FontAttributes="Bold"
                                                        TextColor="{StaticResource BrandButton}"
                                                        VerticalOptions="Center" />
                                                </Grid>
                                            </Border>
                                        </DataTemplate>
                                    </BindableLayout.ItemTemplate>
                                </VerticalStackLayout>
                            </VerticalStackLayout>
                        </Border>

                        <!-- Total -->
                        <Border
                            BackgroundColor="{StaticResource BrandBackground}"
                            Stroke="{StaticResource BrandButton}"
                            StrokeThickness="1"
                            StrokeShape="RoundRectangle 18"
                            Padding="0">
                            <Grid ColumnDefinitions="4,*">
                                <BoxView Color="{StaticResource BrandButton}" VerticalOptions="Fill" />
                                <Grid
                                    Grid.Column="1"
                                    Padding="18,16"
                                    ColumnDefinitions="*,Auto"
                                    ColumnSpacing="12">
                                    <VerticalStackLayout Spacing="6" VerticalOptions="Center">
                                        <Label Text="UKUPNO" Style="{StaticResource SectionCaption}" />
                                        <Label
                                            Text="{Binding TotalDurationText}"
                                            FontSize="13"
                                            TextColor="{StaticResource TextOnBrandBackground}"
                                            Opacity="0.75" />
                                    </VerticalStackLayout>
                                    <Label
                                        Grid.Column="1"
                                        Text="{Binding TotalPriceText}"
                                        FontSize="26"
                                        FontAttributes="Bold"
                                        TextColor="{StaticResource BrandButton}"
                                        VerticalOptions="Center" />
                                </Grid>
                            </Grid>
                        </Border>

                        <!-- Notes -->
                        <Border Style="{StaticResource SectionCard}" IsVisible="{Binding HasNotes}">
                            <VerticalStackLayout Spacing="8">
                                <Label Text="NAPOMENA" Style="{StaticResource SectionCaption}" />
                                <Label
                                    Text="{Binding Notes}"
                                    FontSize="14"
                                    TextColor="{StaticResource TextOnBrandBackground}"
                                    Opacity="0.85"
                                    LineBreakMode="WordWrap" />
                            </VerticalStackLayout>
                        </Border>

                    </VerticalStackLayout>
                </ScrollView>

                <!-- Footer -->
                <Button
                    Grid.Row="2"
                    Text="Zatvori"
                    FontSize="15"
                    FontAttributes="Bold"
                    TextColor="{StaticResource BrandBackground}"
                    BackgroundColor="{StaticResource BrandButton}"
                    CornerRadius="14"
                    HeightRequest="48"
                    Margin="20,8,20,18"
                    Clicked="OnCloseClicked" />

            </Grid>
        </Border>
    </Grid>
</ContentPage>
