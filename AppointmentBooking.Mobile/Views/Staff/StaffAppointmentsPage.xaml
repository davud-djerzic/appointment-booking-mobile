<?xml version="1.0" encoding="utf-8" ?>

<ContentPage
    x:Class="AppointmentBooking.Mobile.Views.Staff.StaffAppointmentsPage"
    xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
    xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
    xmlns:viewModels="clr-namespace:AppointmentBooking.Mobile.ViewModels.Staff"
    xmlns:bookingModels="clr-namespace:AppointmentBooking.Mobile.Models.Bookings.Responses"
    x:Name="RootPage"
    x:DataType="viewModels:StaffAppointmentsViewModel"
    BackgroundColor="{StaticResource Background}"
    Shell.NavBarIsVisible="False"
    SafeAreaEdges="All">

    <Grid
        RowDefinitions="Auto,Auto,*"
        Padding="20,18,20,0">

        <!-- HEADER -->
        <Grid
            Grid.Row="0"
            ColumnDefinitions="*,Auto,Auto"
            Margin="0,0,0,18">

            <VerticalStackLayout
                Spacing="3">

                <Label
                    Text="Termini"
                    FontSize="28"
                    FontAttributes="Bold"
                    TextColor="{StaticResource TextPrimary}" />

                <Label
                    Text="Pregled vaših termina"
                    FontSize="14"
                    TextColor="{StaticResource TextSecondary}" />

            </VerticalStackLayout>

            <Button
                Grid.Column="1"
                Text="＋ Termin"
                Clicked="OnCreateStaffBookingClicked"
                BackgroundColor="{StaticResource Accent}"
                TextColor="{StaticResource Primary}"
                FontAttributes="Bold"
                FontSize="12"
                HeightRequest="42"
                CornerRadius="12"
                Padding="12,0"
                VerticalOptions="Center"
                Margin="0,0,8,0" />

            <ActivityIndicator
                Grid.Column="2"
                IsRunning="{Binding IsLoading}"
                IsVisible="{Binding IsLoading}"
                Color="{StaticResource Primary}"
                HeightRequest="24"
                WidthRequest="24"
                VerticalOptions="Center" />

        </Grid>


        <!-- DATE NAVIGATION -->
        <VerticalStackLayout
            Grid.Row="1"
            Margin="0,0,0,18">

            <Border
                BackgroundColor="{StaticResource Surface}"
                Stroke="{StaticResource Border}"
                StrokeThickness="1"
                StrokeShape="RoundRectangle 18"
                Padding="10">

                <Grid
                    ColumnDefinitions="Auto,*,Auto"
                    ColumnSpacing="10">

                    <!-- PREVIOUS -->
                    <Button
                        Grid.Column="0"
                        Text="‹"
                        Command="{Binding PreviousDayCommand}"
                        BackgroundColor="Transparent"
                        TextColor="{StaticResource TextPrimary}"
                        FontSize="30"
                        WidthRequest="48"
                        HeightRequest="48"
                        Padding="0" />

                    <!-- CURRENT DATE -->
                    <VerticalStackLayout
                        Grid.Column="1"
                        Spacing="2"
                        HorizontalOptions="Center"
                        VerticalOptions="Center">

                        <Label
                            Text="{Binding SelectedDateTitle}"
                            FontSize="18"
                            FontAttributes="Bold"
                            TextColor="{StaticResource TextPrimary}"
                            HorizontalTextAlignment="Center" />

                        <Label
                            Text="{Binding SelectedDateDisplay}"
                            FontSize="13"
                            TextColor="{StaticResource TextSecondary}"
                            HorizontalTextAlignment="Center" />

                    </VerticalStackLayout>

                    <!-- NEXT -->
                    <Button
                        Grid.Column="2"
                        Text="›"
                        Command="{Binding NextDayCommand}"
                        BackgroundColor="Transparent"
                        TextColor="{StaticResource TextPrimary}"
                        FontSize="30"
                        WidthRequest="48"
                        HeightRequest="48"
                        Padding="0" />

                </Grid>

            </Border>

        </VerticalStackLayout>


        <!-- APPOINTMENTS -->
        <Grid
            Grid.Row="2"
            RowDefinitions="Auto,*">

            <Border
                Grid.Row="0"
                IsVisible="{Binding IsTodaySelected}"
                Margin="0,0,0,14"
                Padding="4"
                BackgroundColor="{StaticResource Surface}"
                StrokeThickness="0"
                StrokeShape="RoundRectangle 14">

                <Grid ColumnDefinitions="*,*">
                    <Border
                        Grid.Column="0"
                        Padding="10,9"
                        BackgroundColor="{Binding UpcomingSegmentBackground}"
                        StrokeThickness="0"
                        StrokeShape="RoundRectangle 10">
                        <Border.GestureRecognizers>
                            <TapGestureRecognizer Tapped="OnUpcomingTodayTapped" />
                        </Border.GestureRecognizers>
                        <Label
                            Text="{Binding UpcomingTodaySegmentLabel}"
                            FontSize="14"
                            FontAttributes="Bold"
                            TextColor="{Binding UpcomingSegmentTextColor}"
                            HorizontalTextAlignment="Center"
                            VerticalTextAlignment="Center" />
                    </Border>

                    <Border
                        Grid.Column="1"
                        Padding="10,9"
                        BackgroundColor="{Binding PassedSegmentBackground}"
                        StrokeThickness="0"
                        StrokeShape="RoundRectangle 10">
                        <Border.GestureRecognizers>
                            <TapGestureRecognizer Tapped="OnPassedTodayTapped" />
                        </Border.GestureRecognizers>
                        <Label
                            Text="{Binding PassedTodaySegmentLabel}"
                            FontSize="14"
                            FontAttributes="Bold"
                            TextColor="{Binding PassedSegmentTextColor}"
                            HorizontalTextAlignment="Center"
                            VerticalTextAlignment="Center" />
                    </Border>
                </Grid>
            </Border>

            <CollectionView
                Grid.Row="1"
                ItemsSource="{Binding VisibleAppointments}"
                SelectionMode="None">

                <CollectionView.EmptyView>

                    <VerticalStackLayout
                        HorizontalOptions="Center"
                        VerticalOptions="Center"
                        Spacing="8">

                        <Label
                            Text="📅"
                            FontSize="42"
                            HorizontalTextAlignment="Center" />

                        <Label
                            Text="{Binding EmptyAppointmentsTitle}"
                            FontSize="18"
                            FontAttributes="Bold"
                            TextColor="{StaticResource TextPrimary}"
                            HorizontalTextAlignment="Center" />

                        <Label
                            Text="Za odabrani dan nema zakazanih termina."
                            FontSize="14"
                            TextColor="{StaticResource TextSecondary}"
                            HorizontalTextAlignment="Center" />

                    </VerticalStackLayout>

                </CollectionView.EmptyView>


                <CollectionView.ItemTemplate>

                    <DataTemplate
                        x:DataType="bookingModels:EmployeeBookingSummaryResponse">

                        <Border
                            BackgroundColor="{StaticResource Surface}"
                            StrokeThickness="0"
                            StrokeShape="RoundRectangle 18"
                            Padding="18"
                            Margin="0,0,0,16">

                            <VerticalStackLayout Spacing="12">

                                <Grid ColumnDefinitions="*,Auto" ColumnSpacing="10">
                                    <Label
                                        Text="{Binding LocalStartsAt, StringFormat='{0:dd.MM.yyyy.}'}"
                                        FontSize="19"
                                        FontAttributes="Bold"
                                        TextColor="{StaticResource TextPrimary}"
                                        VerticalOptions="Center" />

                                    <Border
                                        Grid.Column="1"
                                        BackgroundColor="{StaticResource SurfaceSecondary}"
                                        StrokeThickness="0"
                                        StrokeShape="RoundRectangle 10"
                                        Padding="10,5"
                                        VerticalOptions="Center">
                                        <Label
                                            Text="{Binding StatusName}"
                                            FontSize="12"
                                            FontAttributes="Bold"
                                            TextColor="{StaticResource TextSecondary}" />
                                    </Border>
                                </Grid>

                                <Grid ColumnDefinitions="Auto,Auto,Auto" ColumnSpacing="7">
                                    <Label
                                        Text="{Binding LocalStartsAt, StringFormat='{0:HH:mm}'}"
                                        FontSize="17"
                                        FontAttributes="Bold"
                                        TextColor="{StaticResource Primary}" />
                                    <Label
                                        Grid.Column="1"
                                        Text="–"
                                        FontSize="17"
                                        FontAttributes="Bold"
                                        TextColor="{StaticResource Primary}" />
                                    <Label
                                        Grid.Column="2"
                                        Text="{Binding LocalEndsAt, StringFormat='{0:HH:mm}'}"
                                        FontSize="17"
                                        FontAttributes="Bold"
                                        TextColor="{StaticResource Primary}" />
                                </Grid>

                                <BoxView
                                    HeightRequest="1"
                                    Color="{StaticResource BorderColor}" />

                                <Grid ColumnDefinitions="Auto,*" ColumnSpacing="8">
                                    <Label
                                        Text="Klijent:"
                                        FontSize="14"
                                        TextColor="{StaticResource TextSecondary}" />
                                    <Label
                                        Grid.Column="1"
                                        Text="{Binding CustomerName}"
                                        FontSize="15"
                                        FontAttributes="Bold"
                                        TextColor="{StaticResource TextPrimary}"
                                        LineBreakMode="TailTruncation" />
                                </Grid>

                                <Grid ColumnDefinitions="Auto,*" ColumnSpacing="8">
                                    <Label
                                        Text="Trajanje:"
                                        FontSize="14"
                                        TextColor="{StaticResource TextSecondary}" />
                                    <Label
                                        Grid.Column="1"
                                        Text="{Binding DurationText}"
                                        FontSize="15"
                                        TextColor="{StaticResource TextPrimary}" />
                                </Grid>

                                <Grid ColumnDefinitions="Auto,*" ColumnSpacing="8">
                                    <Label
                                        Text="Cijena:"
                                        FontSize="14"
                                        TextColor="{StaticResource TextSecondary}" />
                                    <Label
                                        Grid.Column="1"
                                        Text="{Binding PriceText}"
                                        FontSize="15"
                                        FontAttributes="Bold"
                                        TextColor="{StaticResource TextPrimary}" />
                                </Grid>

                                <Button
                                    Text="Detalji termina"
                                    FontSize="14"
                                    FontAttributes="Bold"
                                    TextColor="{StaticResource TextOnPrimary}"
                                    BackgroundColor="{StaticResource Primary}"
                                    CornerRadius="12"
                                    HeightRequest="44"
                                    Margin="0,4,0,0"
                                    Clicked="OnBookingDetailsClicked"
                                    CommandParameter="{Binding .}" />

                            </VerticalStackLayout>

                        </Border>

                    </DataTemplate>

                </CollectionView.ItemTemplate>

            </CollectionView>

        </Grid>

    </Grid>

</ContentPage>
