<?xml version="1.0" encoding="utf-8" ?>

<ContentPage
    x:Class="AppointmentBooking.Mobile.Views.Staff.StaffPanelPage"
    xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
    xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
    xmlns:viewModels="clr-namespace:AppointmentBooking.Mobile.ViewModels.Staff"
    xmlns:availabilityModels="clr-namespace:AppointmentBooking.Mobile.Models.EmployeeUnavailability"
    xmlns:workingHoursModels="clr-namespace:AppointmentBooking.Mobile.Models.EmployeeWorkingHours"
    x:Name="RootPage"
    x:DataType="viewModels:StaffAvailabilityViewModel"
    BackgroundColor="{StaticResource BrandBackground}"
    Shell.NavBarIsVisible="False"
    SafeAreaEdges="All">

    <ContentPage.Resources>
        <DataTemplate x:Key="UnavailabilityTemplate" x:DataType="availabilityModels:EmployeeUnavailabilityResponse">
            <Border
                Padding="0"
                BackgroundColor="{StaticResource BrandBackground}"
                Stroke="{StaticResource PanelBorder}"
                StrokeThickness="0.8"
                StrokeShape="RoundRectangle 16">
                <Grid ColumnDefinitions="5,*">
                    <BoxView Grid.Column="0" Color="{StaticResource BrandButton}" VerticalOptions="Fill" />
                    <VerticalStackLayout Grid.Column="1" Padding="14" Spacing="10">
                        <Grid ColumnDefinitions="*,Auto" ColumnSpacing="8">
                            <Label Text="{Binding TypeLabel}" FontSize="16" FontAttributes="Bold" TextColor="{StaticResource TextOnBrandBackground}" VerticalOptions="Center" />
                            <Border Grid.Column="1" Padding="10,5" BackgroundColor="{StaticResource QuickBookingPanelBackground}" Stroke="{StaticResource PanelBorder}" StrokeThickness="0.8" StrokeShape="RoundRectangle 10" VerticalOptions="Center">
                                <Label Text="{Binding StateLabel}" FontSize="11" FontAttributes="Bold" TextColor="{StaticResource BrandButton}" />
                            </Border>
                        </Grid>
                        <Label Text="{Binding PeriodDisplay}" FontSize="14" FontAttributes="Bold" TextColor="{StaticResource BrandButton}" />
                        <Label Text="{Binding NoteDisplay}" FontSize="13" TextColor="{StaticResource TextOnBrandBackground}" Opacity="0.7" LineBreakMode="TailTruncation" />
                        <Grid RowDefinitions="Auto,Auto" ColumnDefinitions="*,Auto,Auto" ColumnSpacing="8" RowSpacing="8">
                            <Label Grid.Row="0" Grid.ColumnSpan="3" Text="Izmjene su dostupne prije početka odsustva" IsVisible="{Binding IsEditVisible}" FontSize="11" TextColor="{StaticResource TextOnBrandBackground}" Opacity="0.5" VerticalOptions="Center" />
                            <Button Grid.Row="1" Grid.Column="1" Text="Uredi" Clicked="OnEditClicked" CommandParameter="{Binding .}" IsEnabled="{Binding CanEdit}" IsVisible="{Binding IsEditVisible}" BackgroundColor="{StaticResource QuickBookingPanelBackground}" BorderColor="{StaticResource PanelBorder}" BorderWidth="1" TextColor="{StaticResource TextOnBrandBackground}" FontAttributes="Bold" FontSize="12" HeightRequest="38" CornerRadius="11" Padding="13,0" />
                            <Button Grid.Row="1" Grid.Column="2" Text="Obriši" Clicked="OnDeleteClicked" CommandParameter="{Binding .}" BackgroundColor="{StaticResource QuickBookingPanelBackground}" BorderColor="{StaticResource Error}" BorderWidth="1" TextColor="{StaticResource Error}" FontAttributes="Bold" FontSize="12" HeightRequest="38" CornerRadius="11" Padding="13,0" />
                        </Grid>
                    </VerticalStackLayout>
                </Grid>
            </Border>
        </DataTemplate>
    </ContentPage.Resources>

    <Grid Padding="20,18,20,0" RowDefinitions="Auto,*">
        <!-- Header -->
        <Grid
            Grid.Row="0"
            ColumnDefinitions="*,Auto"
            ColumnSpacing="12"
            Margin="0,0,0,18">
            <VerticalStackLayout Spacing="3" VerticalOptions="Center">
                <Label
                    Text="Pauze"
                    FontSize="28"
                    FontAttributes="Bold"
                    TextColor="{StaticResource TextOnBrandBackground}" />
            </VerticalStackLayout>

            <Button
                Grid.Column="1"
                Text="Odjavi se"
                Clicked="OnLogoutClicked"
                BackgroundColor="{StaticResource QuickBookingPanelBackground}"
                BorderColor="{StaticResource Error}"
                BorderWidth="1"
                TextColor="{StaticResource Error}"
                FontAttributes="Bold"
                FontSize="13"
                HeightRequest="42"
                CornerRadius="12"
                Padding="14,0"
                VerticalOptions="Center" />
        </Grid>

        <ScrollView Grid.Row="1">
            <VerticalStackLayout Spacing="16" Padding="0,0,0,28">
                <!-- Stalne pauze -->
                <Border
                    Padding="18"
                    BackgroundColor="{StaticResource QuickBookingPanelBackground}"
                    Stroke="{StaticResource PanelBorder}"
                    StrokeThickness="1"
                    StrokeShape="RoundRectangle 20">
                    <VerticalStackLayout Spacing="15">
                        <VerticalStackLayout Spacing="4">
                            <Label
                                Text="Stalne pauze"
                                FontSize="21"
                                FontAttributes="Bold"
                                TextColor="{StaticResource TextOnBrandBackground}" />
                        </VerticalStackLayout>

                        <VerticalStackLayout Spacing="8">
                            <Label Text="DANI U SEDMICI" FontSize="11" FontAttributes="Bold" CharacterSpacing="1" TextColor="{StaticResource TextOnBrandBackground}" Opacity="0.6" />
                
                            <Border Padding="10" BackgroundColor="{StaticResource BrandBackground}" Stroke="{StaticResource PanelBorder}" StrokeThickness="0.8" StrokeShape="RoundRectangle 16">
                                <Grid
                                    BindableLayout.ItemsSource="{Binding RecurringBreakDays}"
                                    ColumnDefinitions="*,*,*,*,*"
                                    ColumnSpacing="6">
                                    <BindableLayout.ItemTemplate>
                                        <DataTemplate x:DataType="workingHoursModels:RecurringBreakDayOption">
                                            <Button
                                                Grid.Column="{Binding ColumnIndex}"
                                                Text="{Binding DisplayLabel}"
                                                Clicked="OnRecurringBreakDayClicked"
                                                CommandParameter="{Binding .}"
                                                BackgroundColor="{Binding BackgroundColor}"
                                                TextColor="{Binding TextColor}"
                                                BorderColor="{Binding BorderColor}"
                                                BorderWidth="1"
                                                FontAttributes="Bold"
                                                FontSize="12"
                                                HeightRequest="44"
                                                CornerRadius="13"
                                                Padding="4,0"
                                                Margin="0"
                                                HorizontalOptions="Fill"
                                                VerticalOptions="Center" />
                                        </DataTemplate>
                                    </BindableLayout.ItemTemplate>
                                </Grid>
                            </Border>
                            <Label Text="{Binding RecurringBreakDaySelectionDisplay}" FontSize="12" FontAttributes="Bold" TextColor="{StaticResource BrandButton}" />
                        </VerticalStackLayout>

                        <Grid ColumnDefinitions="*,*" ColumnSpacing="12">
                            <VerticalStackLayout Spacing="6">
                                <Label Text="Početak pauze" FontSize="13" FontAttributes="Bold" TextColor="{StaticResource TextOnBrandBackground}" Opacity="0.7" />
                                <Button
                                    Text="{Binding RecurringBreakStartsAtDisplay}"
                                    Command="{Binding OpenRecurringBreakStartTimeSelectorCommand}"
                                    BackgroundColor="{StaticResource BrandBackground}"
                                    TextColor="{StaticResource BrandButton}"
                                    BorderColor="{StaticResource PanelBorder}"
                                    BorderWidth="1"
                                    FontSize="16"
                                    FontAttributes="Bold"
                                    HeightRequest="48"
                                    CornerRadius="12" />
                            </VerticalStackLayout>
                            <VerticalStackLayout Grid.Column="1" Spacing="6">
                                <Label Text="Kraj pauze" FontSize="13" FontAttributes="Bold" TextColor="{StaticResource TextOnBrandBackground}" Opacity="0.7" />
                                <Button
                                    Text="{Binding RecurringBreakEndsAtDisplay}"
                                    Command="{Binding OpenRecurringBreakEndTimeSelectorCommand}"
                                    BackgroundColor="{StaticResource BrandBackground}"
                                    TextColor="{StaticResource BrandButton}"
                                    BorderColor="{StaticResource PanelBorder}"
                                    BorderWidth="1"
                                    FontSize="16"
                                    FontAttributes="Bold"
                                    HeightRequest="48"
                                    CornerRadius="12" />
                            </VerticalStackLayout>
                        </Grid>

                        <Button
                            Text="Primijeni za odabrane dane"
                            Command="{Binding ApplyRecurringBreakCommand}"
                            IsEnabled="{Binding CanApplyRecurringBreak}"
                            BackgroundColor="{StaticResource BrandButton}"
                            TextColor="{StaticResource BrandBackground}"
                            FontAttributes="Bold"
                            HeightRequest="48"
                            CornerRadius="13" />

                        <ActivityIndicator
                            IsRunning="{Binding IsWorkingHoursLoading}"
                            IsVisible="{Binding IsWorkingHoursLoading}"
                            Color="{StaticResource BrandButton}"
                            HorizontalOptions="Center" />

                        <VerticalStackLayout Spacing="8" BindableLayout.ItemsSource="{Binding WeeklyBreaks}">
                            <BindableLayout.ItemTemplate>
                                <DataTemplate x:DataType="workingHoursModels:WeeklyWorkingHoursDayDisplay">
                                    <Border
                                        BackgroundColor="{StaticResource BrandBackground}"
                                        Stroke="{StaticResource PanelBorder}"
                                        StrokeThickness="0.8"
                                        StrokeShape="RoundRectangle 12"
                                        Padding="14,10">
                                        <Grid ColumnDefinitions="*,Auto">
                                            <Label Text="{Binding DayLabel}" FontSize="13" FontAttributes="Bold" TextColor="{StaticResource TextOnBrandBackground}" VerticalOptions="Center" />
                                            <Label Grid.Column="1" Text="{Binding HoursLabel}" FontSize="13" FontAttributes="Bold" TextColor="{StaticResource BrandButton}" HorizontalTextAlignment="End" VerticalOptions="Center" />
                                        </Grid>
                                    </Border>
                                </DataTemplate>
                            </BindableLayout.ItemTemplate>
                        </VerticalStackLayout>
                    </VerticalStackLayout>
                </Border>

                <!-- Pauze -->
                <Border
                    Padding="18"
                    BackgroundColor="{StaticResource QuickBookingPanelBackground}"
                    Stroke="{StaticResource PanelBorder}"
                    StrokeThickness="1"
                    StrokeShape="RoundRectangle 20">
                    <VerticalStackLayout Spacing="16">
                        <Grid ColumnDefinitions="*,Auto" ColumnSpacing="12">
                            <VerticalStackLayout Spacing="4">
                                <Label
                                    Text="Pauze"
                                    FontSize="21"
                                    FontAttributes="Bold"
                                    TextColor="{StaticResource TextOnBrandBackground}" />
                            </VerticalStackLayout>
                            <Button
                                Grid.Column="1"
                                Text="＋  Dodaj pauzu"
                                Clicked="OnAddClicked"
                                BackgroundColor="{StaticResource BrandButton}"
                                TextColor="{StaticResource BrandBackground}"
                                FontAttributes="Bold"
                                FontSize="14"
                                HeightRequest="44"
                                CornerRadius="13"
                                Padding="14,0"
                                VerticalOptions="Center" />
                        </Grid>

                        <ActivityIndicator
                            IsRunning="{Binding IsLoading}"
                            IsVisible="{Binding IsLoading}"
                            Color="{StaticResource BrandButton}"
                            HorizontalOptions="Center"
                            Margin="0,8" />

                        <Label Text="AKTUELNE I BUDUĆE PAUZE" FontSize="12" FontAttributes="Bold" CharacterSpacing="1" TextColor="{StaticResource TextOnBrandBackground}" Opacity="0.65" />
                        <Label IsVisible="{Binding HasNoUpcomingBreaks}" Text="Nema budućih pauza." FontSize="13" TextColor="{StaticResource TextOnBrandBackground}" Opacity="0.7" />
                        <VerticalStackLayout BindableLayout.ItemsSource="{Binding UpcomingBreaks}" BindableLayout.ItemTemplate="{StaticResource UnavailabilityTemplate}" Spacing="12" />

                        <Label Text="PROŠLE PAUZE" FontSize="12" FontAttributes="Bold" CharacterSpacing="1" TextColor="{StaticResource TextOnBrandBackground}" Opacity="0.65" Margin="0,8,0,0" />
                        <Label IsVisible="{Binding HasNoPastBreaks}" Text="Nema prošlih pauza." FontSize="13" TextColor="{StaticResource TextOnBrandBackground}" Opacity="0.7" />
                        <VerticalStackLayout BindableLayout.ItemsSource="{Binding PastBreaks}" BindableLayout.ItemTemplate="{StaticResource UnavailabilityTemplate}" Spacing="12" />
                    </VerticalStackLayout>
                </Border>

                <!-- Godišnji odmori -->
                <Border
                    Padding="18"
                    BackgroundColor="{StaticResource QuickBookingPanelBackground}"
                    Stroke="{StaticResource PanelBorder}"
                    StrokeThickness="1"
                    StrokeShape="RoundRectangle 20">
                    <VerticalStackLayout Spacing="16">
                        <Grid ColumnDefinitions="*,Auto" ColumnSpacing="12">
                            <VerticalStackLayout Spacing="4">
                                <Label Text="Godišnji odmori" FontSize="21" FontAttributes="Bold" TextColor="{StaticResource TextOnBrandBackground}" />
                             
                            </VerticalStackLayout>
                            <Button Grid.Column="1" Text="＋  Dodaj godišnji" Clicked="OnAddVacationClicked" BackgroundColor="{StaticResource BrandButton}" TextColor="{StaticResource BrandBackground}" FontAttributes="Bold" FontSize="14" HeightRequest="44" CornerRadius="13" Padding="14,0" VerticalOptions="Center" />
                        </Grid>

                        <Label Text="AKTUELNI I BUDUĆI GODIŠNJI ODMORI" FontSize="12" FontAttributes="Bold" CharacterSpacing="1" TextColor="{StaticResource TextOnBrandBackground}" Opacity="0.65" />
                        <Label IsVisible="{Binding HasNoUpcomingVacations}" Text="Nema budućih godišnjih odmora." FontSize="13" TextColor="{StaticResource TextOnBrandBackground}" Opacity="0.7" />
                        <VerticalStackLayout BindableLayout.ItemsSource="{Binding UpcomingVacations}" BindableLayout.ItemTemplate="{StaticResource UnavailabilityTemplate}" Spacing="12" />

                        <Label Text="PROŠLI GODIŠNJI ODMORI" FontSize="12" FontAttributes="Bold" CharacterSpacing="1" TextColor="{StaticResource TextOnBrandBackground}" Opacity="0.65" Margin="0,8,0,0" />
                        <Label IsVisible="{Binding HasNoPastVacations}" Text="Nema prošlih godišnjih odmora." FontSize="13" TextColor="{StaticResource TextOnBrandBackground}" Opacity="0.7" />
                        <VerticalStackLayout BindableLayout.ItemsSource="{Binding PastVacations}" BindableLayout.ItemTemplate="{StaticResource UnavailabilityTemplate}" Spacing="12" />
                    </VerticalStackLayout>
                </Border>
            </VerticalStackLayout>
        </ScrollView>

        <!-- Time selector popup -->
        <Grid
            Grid.RowSpan="2"
            IsVisible="{Binding IsPageTimeSelectorVisible}"
            BackgroundColor="#B3000000"
            Padding="24">
            <Border
                MaximumWidthRequest="420"
                Padding="22"
                BackgroundColor="{StaticResource QuickBookingPanelBackground}"
                Stroke="{StaticResource PanelBorder}"
                StrokeThickness="1"
                StrokeShape="RoundRectangle 22"
                HorizontalOptions="Center"
                VerticalOptions="Center">
                <VerticalStackLayout Spacing="18">
                    <VerticalStackLayout Spacing="4">
                        <Label Text="{Binding TimeSelectorTitle}" FontSize="21" FontAttributes="Bold" TextColor="{StaticResource TextOnBrandBackground}" />
                        <Label Text="Unesite sat i minute u formatu 24 sata." FontSize="13" TextColor="{StaticResource TextOnBrandBackground}" Opacity="0.7" />
                    </VerticalStackLayout>

                    <Grid ColumnDefinitions="*,Auto,*" ColumnSpacing="12">
                        <VerticalStackLayout Spacing="8">
                            <Label Text="SAT" FontSize="11" FontAttributes="Bold" HorizontalTextAlignment="Center" TextColor="{StaticResource TextOnBrandBackground}" Opacity="0.6" />
                            <Border Padding="4" BackgroundColor="{StaticResource BrandBackground}" Stroke="{StaticResource PanelBorder}" StrokeThickness="1" StrokeShape="RoundRectangle 14">
                                <Entry Text="{Binding TimeSelectorHour}" Keyboard="Numeric" MaxLength="2" HorizontalTextAlignment="Center" FontSize="30" FontAttributes="Bold" TextColor="{StaticResource BrandButton}" BackgroundColor="Transparent" />
                            </Border>
                        </VerticalStackLayout>
                        <Label Grid.Column="1" Text=":" FontSize="30" FontAttributes="Bold" VerticalOptions="End" Margin="0,0,0,5" TextColor="{StaticResource BrandButton}" />
                        <VerticalStackLayout Grid.Column="2" Spacing="8">
                            <Label Text="MINUTE" FontSize="11" FontAttributes="Bold" HorizontalTextAlignment="Center" TextColor="{StaticResource TextOnBrandBackground}" Opacity="0.6" />
                            <Border Padding="4" BackgroundColor="{StaticResource BrandBackground}" Stroke="{StaticResource PanelBorder}" StrokeThickness="1" StrokeShape="RoundRectangle 14">
                                <Entry Text="{Binding TimeSelectorMinute}" Keyboard="Numeric" MaxLength="2" HorizontalTextAlignment="Center" FontSize="30" FontAttributes="Bold" TextColor="{StaticResource BrandButton}" BackgroundColor="Transparent" />
                            </Border>
                        </VerticalStackLayout>
                    </Grid>

                    <Grid ColumnDefinitions="*,*" ColumnSpacing="10">
                        <Button Text="Zatvori" Command="{Binding CloseTimeSelectorCommand}" BackgroundColor="{StaticResource BrandBackground}" BorderColor="{StaticResource PanelBorder}" BorderWidth="1" TextColor="{StaticResource TextOnBrandBackground}" FontAttributes="Bold" HeightRequest="48" CornerRadius="12" />
                        <Button Grid.Column="1" Text="Potvrdi" Command="{Binding ConfirmTimeSelectorCommand}" BackgroundColor="{StaticResource BrandButton}" TextColor="{StaticResource BrandBackground}" FontAttributes="Bold" HeightRequest="48" CornerRadius="12" />
                    </Grid>
                </VerticalStackLayout>
            </Border>
        </Grid>
    </Grid>
</ContentPage>
