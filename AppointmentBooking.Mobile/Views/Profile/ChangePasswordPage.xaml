<?xml version="1.0" encoding="utf-8" ?>

<ContentPage
    x:Class="AppointmentBooking.Mobile.Views.Profile.ChangePasswordPage"
    xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
    xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
    xmlns:viewModels="clr-namespace:AppointmentBooking.Mobile.ViewModels.Profile"
    x:DataType="viewModels:ChangePasswordViewModel"
    BackgroundColor="{StaticResource Background}"
    Shell.NavBarIsVisible="False"
    SafeAreaEdges="All">

    <Grid
        RowDefinitions="Auto,*"
        Padding="20,18,20,16">

        <!-- HEADER -->

        <Grid
            Grid.Row="0"
            ColumnDefinitions="Auto,*"
            ColumnSpacing="14"
            Margin="0,0,0,24">

            <Button
                Grid.Column="0"
                Text="‹"
                FontSize="30"
                WidthRequest="46"
                HeightRequest="46"
                Padding="0"
                BackgroundColor="{StaticResource SurfaceSecondary}"
                TextColor="{StaticResource TextPrimary}"
                CornerRadius="14"
                Command="{Binding GoBackCommand}" />

            <VerticalStackLayout
                Grid.Column="1"
                Spacing="4"
                VerticalOptions="Center">

                <Label
                    Text="Promijeni lozinku"
                    FontSize="28"
                    FontAttributes="Bold"
                    TextColor="{StaticResource TextPrimary}" />

                <Label
                    Text="Ažurirajte lozinku svog naloga"
                    FontSize="14"
                    TextColor="{StaticResource TextSecondary}" />

            </VerticalStackLayout>

        </Grid>


        <!-- CONTENT -->

        <ScrollView Grid.Row="1">

            <VerticalStackLayout
                Spacing="18"
                Padding="0,0,0,24">

                <!-- INFO -->

                <Border
                    BackgroundColor="{StaticResource SurfaceSecondary}"
                    StrokeThickness="0"
                    StrokeShape="RoundRectangle 18"
                    Padding="16">

                    <VerticalStackLayout Spacing="4">

                        <Label
                            Text="Sigurnost naloga"
                            FontSize="16"
                            FontAttributes="Bold"
                            TextColor="{StaticResource TextPrimary}" />

                        <Label
                            Text="Unesite trenutnu lozinku, a zatim novu lozinku koju želite koristiti."
                            FontSize="13"
                            TextColor="{StaticResource TextSecondary}" />

                    </VerticalStackLayout>

                </Border>


                <!-- CURRENT PASSWORD -->

                <VerticalStackLayout Spacing="10">

                    <Label
                        Text="Trenutna lozinka"
                        FontSize="20"
                        FontAttributes="Bold"
                        TextColor="{StaticResource TextPrimary}" />

                    <Border
                        BackgroundColor="{StaticResource Surface}"
                        Stroke="{StaticResource Border}"
                        StrokeThickness="1"
                        StrokeShape="RoundRectangle 16"
                        Padding="14">

                        <VerticalStackLayout Spacing="3">

                            <Label
                                Text="Lozinka"
                                FontSize="11"
                                TextColor="{StaticResource TextMuted}" />

                            <Entry
                                Text="{Binding CurrentPassword}"
                                IsPassword="True"
                                FontSize="16"
                                TextColor="{StaticResource TextPrimary}"
                                BackgroundColor="Transparent"
                                ClearButtonVisibility="WhileEditing" />

                        </VerticalStackLayout>

                    </Border>

                </VerticalStackLayout>


                <!-- NEW PASSWORD -->

                <VerticalStackLayout Spacing="10">

                    <Label
                        Text="Nova lozinka"
                        FontSize="20"
                        FontAttributes="Bold"
                        TextColor="{StaticResource TextPrimary}" />

                    <Border
                        BackgroundColor="{StaticResource Surface}"
                        Stroke="{StaticResource Border}"
                        StrokeThickness="1"
                        StrokeShape="RoundRectangle 16"
                        Padding="14">

                        <VerticalStackLayout Spacing="3">

                            <Label
                                Text="Nova lozinka"
                                FontSize="11"
                                TextColor="{StaticResource TextMuted}" />

                            <Entry
                                Text="{Binding NewPassword}"
                                IsPassword="True"
                                FontSize="16"
                                TextColor="{StaticResource TextPrimary}"
                                BackgroundColor="Transparent"
                                ClearButtonVisibility="WhileEditing" />

                        </VerticalStackLayout>

                    </Border>

                    <Label
                        Text="Lozinka mora sadržavati između 8 i 100 znakova."
                        FontSize="12"
                        TextColor="{StaticResource TextSecondary}"
                        Margin="2,0,0,0" />

                </VerticalStackLayout>


                <!-- CONFIRM PASSWORD -->

                <VerticalStackLayout Spacing="10">

                    <Label
                        Text="Potvrda lozinke"
                        FontSize="20"
                        FontAttributes="Bold"
                        TextColor="{StaticResource TextPrimary}" />

                    <Border
                        BackgroundColor="{StaticResource Surface}"
                        Stroke="{StaticResource Border}"
                        StrokeThickness="1"
                        StrokeShape="RoundRectangle 16"
                        Padding="14">

                        <VerticalStackLayout Spacing="3">

                            <Label
                                Text="Potvrdi novu lozinku"
                                FontSize="11"
                                TextColor="{StaticResource TextMuted}" />

                            <Entry
                                Text="{Binding ConfirmPassword}"
                                IsPassword="True"
                                FontSize="16"
                                TextColor="{StaticResource TextPrimary}"
                                BackgroundColor="Transparent"
                                ClearButtonVisibility="WhileEditing" />

                        </VerticalStackLayout>

                    </Border>

                </VerticalStackLayout>


                <!-- CHANGE PASSWORD BUTTON -->

                <Button
                    Text="PROMIJENI LOZINKU"
                    Command="{Binding ChangePasswordCommand}"
                    BackgroundColor="{StaticResource Accent}"
                    TextColor="{StaticResource Primary}"
                    FontAttributes="Bold"
                    FontSize="14"
                    HeightRequest="52"
                    CornerRadius="14"
                    Margin="0,6,0,0" />


                <!-- LOADING -->

                <ActivityIndicator
                    IsRunning="{Binding IsSaving}"
                    IsVisible="{Binding IsSaving}"
                    HorizontalOptions="Center"
                    Margin="0,2,0,0" />

            </VerticalStackLayout>

        </ScrollView>

    </Grid>

</ContentPage>