<?xml version="1.0" encoding="utf-8" ?>

<ContentPage
    x:Class="AppointmentBooking.Mobile.Views.Profile.ProfilePage"
    xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
    xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
    xmlns:viewModels="clr-namespace:AppointmentBooking.Mobile.ViewModels.Profile"
    xmlns:toolkit="http://schemas.microsoft.com/dotnet/2022/maui/toolkit"
    xmlns:salonResponses="clr-namespace:AppointmentBooking.Mobile.Models.Salons.Responses"
    x:Name="RootPage"
    x:DataType="viewModels:ProfileViewModel"
    BackgroundColor="{StaticResource Background}"
    Shell.NavBarIsVisible="False"
    SafeAreaEdges="All">

    <ContentPage.Behaviors>
        <toolkit:EventToCommandBehavior
            EventName="Appearing"
            Command="{Binding Source={x:Reference RootPage}, Path=BindingContext.LoadProfileCommand}" />
    </ContentPage.Behaviors>


    <Grid
        RowDefinitions="Auto,*"
        Padding="20,18,20,16">

        <!-- HEADER -->

        <Grid
            Grid.Row="0"
            ColumnDefinitions="*,Auto"
            Margin="0,0,0,24">

            <VerticalStackLayout
                Grid.Column="0"
                Spacing="4">

                <Label
                    Text="Profil"
                    FontSize="28"
                    FontAttributes="Bold"
                    TextColor="{StaticResource TextPrimary}" />

                <Label
                    Text="Upravljajte svojim podacima"
                    FontSize="14"
                    TextColor="{StaticResource TextSecondary}" />

            </VerticalStackLayout>


            <Border
                Grid.Column="1"
                WidthRequest="46"
                HeightRequest="46"
                BackgroundColor="{StaticResource SurfaceSecondary}"
                StrokeThickness="0"
                StrokeShape="RoundRectangle 23"
                VerticalOptions="Center">

                <Label
                    Text="●"
                    FontSize="24"
                    TextColor="{StaticResource Accent}"
                    HorizontalOptions="Center"
                    VerticalOptions="Center" />

            </Border>

        </Grid>


        <!-- CONTENT -->

        <ScrollView Grid.Row="1">

            <VerticalStackLayout
                Spacing="18"
                Padding="0,0,0,24">


                <!-- PROFILE CARD -->

                <Border
                    BackgroundColor="{StaticResource Surface}"
                    Stroke="{StaticResource Border}"
                    StrokeThickness="1"
                    StrokeShape="RoundRectangle 22"
                    Padding="20">

                    <Grid
                        ColumnDefinitions="Auto,*"
                        ColumnSpacing="16">

                        <Border
                            Grid.Column="0"
                            WidthRequest="64"
                            HeightRequest="64"
                            BackgroundColor="{StaticResource Primary}"
                            StrokeThickness="0"
                            StrokeShape="RoundRectangle 32"
                            VerticalOptions="Start">

                            <Label
                                Text="👤"
                                FontSize="28"
                                HorizontalOptions="Center"
                                VerticalOptions="Center" />

                        </Border>


                        <VerticalStackLayout
                            Grid.Column="1"
                            Spacing="5"
                            VerticalOptions="Center">

                            <Label
                                Text="{Binding FirstName}"
                                FontSize="22"
                                FontAttributes="Bold"
                                TextColor="{StaticResource TextPrimary}" />

                            <Label
                                Text="{Binding LastName}"
                                FontSize="18"
                                TextColor="{StaticResource TextPrimary}" />

                            <Label
                                Text="{Binding Email}"
                                FontSize="13"
                                TextColor="{StaticResource TextSecondary}"
                                LineBreakMode="TailTruncation" />

                        </VerticalStackLayout>

                    </Grid>

                </Border>


                <!-- ACCOUNT SECTION -->

                <VerticalStackLayout
                    Spacing="10">

                    <Label
                        Text="Moji podaci"
                        FontSize="20"
                        FontAttributes="Bold"
                        TextColor="{StaticResource TextPrimary}" />


                    <!-- CUSTOMER INFO CARD -->

                    <Border
                        BackgroundColor="{StaticResource SurfaceSecondary}"
                        StrokeThickness="0"
                        StrokeShape="RoundRectangle 18"
                        Padding="16">

                        <Border.GestureRecognizers>

                            <TapGestureRecognizer
                                Command="{Binding ToggleCustomerInfoCommand}" />

                        </Border.GestureRecognizers>


                        <VerticalStackLayout
                            Spacing="14">


                            <!-- CARD HEADER -->

                            <Grid
                                ColumnDefinitions="*,Auto">

                                <VerticalStackLayout
                                    Spacing="3">

                                    <Label
                                        Text="Lični podaci"
                                        FontSize="16"
                                        FontAttributes="Bold"
                                        TextColor="{StaticResource TextPrimary}" />

                                    <Label
                                        Text="Pregledajte i uredite svoje podatke."
                                        FontSize="12"
                                        TextColor="{StaticResource TextSecondary}" />

                                </VerticalStackLayout>


                                <!-- ARROW -->

                                <Label
                                    Grid.Column="1"
                                    Text="›"
                                    FontSize="28"
                                    TextColor="{StaticResource AccentDark}"
                                    VerticalOptions="Center">

                                    <Label.Triggers>

                                        <DataTrigger
                                            TargetType="Label"
                                            Binding="{Binding IsCustomerInfoExpanded}"
                                            Value="True">

                                            <Setter
                                                Property="Rotation"
                                                Value="90" />

                                        </DataTrigger>

                                    </Label.Triggers>

                                </Label>

                            </Grid>


                            <!-- CUSTOMER DETAILS -->

                            <VerticalStackLayout
                                Spacing="10"
                                IsVisible="False">

                                <VerticalStackLayout.Triggers>

                                    <DataTrigger
                                        TargetType="VerticalStackLayout"
                                        Binding="{Binding IsCustomerInfoExpanded}"
                                        Value="True">

                                        <Setter
                                            Property="IsVisible"
                                            Value="True" />

                                    </DataTrigger>

                                </VerticalStackLayout.Triggers>


                                <!-- FIRST NAME -->

                                <Border
                                    BackgroundColor="{StaticResource Surface}"
                                    Stroke="{StaticResource Border}"
                                    StrokeThickness="1"
                                    StrokeShape="RoundRectangle 16"
                                    Padding="14">

                                    <VerticalStackLayout
                                        Spacing="3">

                                        <Label
                                            Text="Ime"
                                            FontSize="11"
                                            TextColor="{StaticResource TextMuted}" />


                                        <!-- VIEW -->

                                        <Label
                                            Text="{Binding FirstName}"
                                            FontSize="16"
                                            FontAttributes="Bold"
                                            TextColor="{StaticResource TextPrimary}">

                                            <Label.Triggers>

                                                <DataTrigger
                                                    TargetType="Label"
                                                    Binding="{Binding IsEditing}"
                                                    Value="True">

                                                    <Setter
                                                        Property="IsVisible"
                                                        Value="False" />

                                                </DataTrigger>

                                            </Label.Triggers>

                                        </Label>


                                        <!-- EDIT -->

                                        <Entry
                                            Text="{Binding FirstName}"
                                            FontSize="16"
                                            TextColor="{StaticResource TextPrimary}"
                                            BackgroundColor="Transparent"
                                            ClearButtonVisibility="WhileEditing"
                                            IsVisible="False">

                                            <Entry.Triggers>

                                                <DataTrigger
                                                    TargetType="Entry"
                                                    Binding="{Binding IsEditing}"
                                                    Value="True">

                                                    <Setter
                                                        Property="IsVisible"
                                                        Value="True" />

                                                </DataTrigger>

                                            </Entry.Triggers>

                                        </Entry>

                                    </VerticalStackLayout>

                                </Border>


                                <!-- LAST NAME -->

                                <Border
                                    BackgroundColor="{StaticResource Surface}"
                                    Stroke="{StaticResource Border}"
                                    StrokeThickness="1"
                                    StrokeShape="RoundRectangle 16"
                                    Padding="14">

                                    <VerticalStackLayout
                                        Spacing="3">

                                        <Label
                                            Text="Prezime"
                                            FontSize="11"
                                            TextColor="{StaticResource TextMuted}" />


                                        <!-- VIEW -->

                                        <Label
                                            Text="{Binding LastName}"
                                            FontSize="16"
                                            FontAttributes="Bold"
                                            TextColor="{StaticResource TextPrimary}">

                                            <Label.Triggers>

                                                <DataTrigger
                                                    TargetType="Label"
                                                    Binding="{Binding IsEditing}"
                                                    Value="True">

                                                    <Setter
                                                        Property="IsVisible"
                                                        Value="False" />

                                                </DataTrigger>

                                            </Label.Triggers>

                                        </Label>


                                        <!-- EDIT -->

                                        <Entry
                                            Text="{Binding LastName}"
                                            FontSize="16"
                                            TextColor="{StaticResource TextPrimary}"
                                            BackgroundColor="Transparent"
                                            ClearButtonVisibility="WhileEditing"
                                            IsVisible="False">

                                            <Entry.Triggers>

                                                <DataTrigger
                                                    TargetType="Entry"
                                                    Binding="{Binding IsEditing}"
                                                    Value="True">

                                                    <Setter
                                                        Property="IsVisible"
                                                        Value="True" />

                                                </DataTrigger>

                                            </Entry.Triggers>

                                        </Entry>

                                    </VerticalStackLayout>

                                </Border>


                                <!-- EMAIL -->

                                <Border
                                    BackgroundColor="{StaticResource Surface}"
                                    Stroke="{StaticResource Border}"
                                    StrokeThickness="1"
                                    StrokeShape="RoundRectangle 16"
                                    Padding="14">

                                    <VerticalStackLayout
                                        Spacing="3">

                                        <Label
                                            Text="Email"
                                            FontSize="11"
                                            TextColor="{StaticResource TextMuted}" />


                                        <!-- VIEW -->

                                        <Label
                                            Text="{Binding Email}"
                                            FontSize="16"
                                            FontAttributes="Bold"
                                            TextColor="{StaticResource TextPrimary}"
                                            LineBreakMode="TailTruncation">

                                            <Label.Triggers>

                                                <DataTrigger
                                                    TargetType="Label"
                                                    Binding="{Binding IsEditing}"
                                                    Value="True">

                                                    <Setter
                                                        Property="IsVisible"
                                                        Value="False" />

                                                </DataTrigger>

                                            </Label.Triggers>

                                        </Label>


                                        <!-- EDIT -->

                                        <Entry
                                            Text="{Binding Email}"
                                            Keyboard="Email"
                                            FontSize="16"
                                            TextColor="{StaticResource TextPrimary}"
                                            BackgroundColor="Transparent"
                                            ClearButtonVisibility="WhileEditing"
                                            IsVisible="False">

                                            <Entry.Triggers>

                                                <DataTrigger
                                                    TargetType="Entry"
                                                    Binding="{Binding IsEditing}"
                                                    Value="True">

                                                    <Setter
                                                        Property="IsVisible"
                                                        Value="True" />

                                                </DataTrigger>

                                            </Entry.Triggers>

                                        </Entry>

                                    </VerticalStackLayout>

                                </Border>


                                <!-- PHONE -->

                                <Border
                                    BackgroundColor="{StaticResource Surface}"
                                    Stroke="{StaticResource Border}"
                                    StrokeThickness="1"
                                    StrokeShape="RoundRectangle 16"
                                    Padding="14">

                                    <VerticalStackLayout
                                        Spacing="3">

                                        <Label
                                            Text="Telefon"
                                            FontSize="11"
                                            TextColor="{StaticResource TextMuted}" />


                                        <!-- VIEW -->

                                        <Label
                                            Text="{Binding Phone}"
                                            FontSize="16"
                                            FontAttributes="Bold"
                                            TextColor="{StaticResource TextPrimary}">

                                            <Label.Triggers>

                                                <DataTrigger
                                                    TargetType="Label"
                                                    Binding="{Binding IsEditing}"
                                                    Value="True">

                                                    <Setter
                                                        Property="IsVisible"
                                                        Value="False" />

                                                </DataTrigger>

                                            </Label.Triggers>

                                        </Label>


                                        <!-- EDIT -->

                                        <Entry
                                            Text="{Binding Phone}"
                                            Keyboard="Telephone"
                                            FontSize="16"
                                            TextColor="{StaticResource TextPrimary}"
                                            BackgroundColor="Transparent"
                                            ClearButtonVisibility="WhileEditing"
                                            IsVisible="False">

                                            <Entry.Triggers>

                                                <DataTrigger
                                                    TargetType="Entry"
                                                    Binding="{Binding IsEditing}"
                                                    Value="True">

                                                    <Setter
                                                        Property="IsVisible"
                                                        Value="True" />

                                                </DataTrigger>

                                            </Entry.Triggers>

                                        </Entry>

                                    </VerticalStackLayout>

                                </Border>


                                <!-- EDIT BUTTON -->

                                <Button
                                    Text="UREDI"
                                    Command="{Binding StartEditingCommand}"
                                    HeightRequest="46"
                                    BackgroundColor="{StaticResource Accent}"
                                    TextColor="{StaticResource Primary}"
                                    FontAttributes="Bold"
                                    FontSize="13"
                                    CornerRadius="14"
                                    Margin="0,4,0,0">

                                    <Button.Triggers>

                                        <DataTrigger
                                            TargetType="Button"
                                            Binding="{Binding IsEditing}"
                                            Value="True">

                                            <Setter
                                                Property="IsVisible"
                                                Value="False" />

                                        </DataTrigger>

                                    </Button.Triggers>

                                </Button>


                                <!-- SAVE BUTTON -->

                                <Button
                                    Text="SAČUVAJ IZMJENE"
                                    Command="{Binding SaveChangesCommand}"
                                    IsVisible="False"
                                    IsEnabled="{Binding CanSave}"
                                    BackgroundColor="{StaticResource Accent}"
                                    TextColor="{StaticResource Primary}"
                                    FontAttributes="Bold"
                                    FontSize="13"
                                    HeightRequest="46"
                                    CornerRadius="14"
                                    Margin="0,4,0,0">

                                    <Button.Triggers>

                                        <DataTrigger
                                            TargetType="Button"
                                            Binding="{Binding IsEditing}"
                                            Value="True">

                                            <Setter
                                                Property="IsVisible"
                                                Value="True" />

                                        </DataTrigger>

                                    </Button.Triggers>

                                </Button>

                            </VerticalStackLayout>

                        </VerticalStackLayout>

                    </Border>

                </VerticalStackLayout>


                <!-- SALON -->

                <VerticalStackLayout
                    Spacing="10">

                    <Label
                        Text="Salon"
                        FontSize="20"
                        FontAttributes="Bold"
                        TextColor="{StaticResource TextPrimary}" />


                    <Border
                        BackgroundColor="{StaticResource Surface}"
                        Stroke="{StaticResource Border}"
                        StrokeThickness="1"
                        StrokeShape="RoundRectangle 22"
                        Padding="18">

                        <VerticalStackLayout
                            Spacing="16">


                            <!-- SALON HEADER -->

                            <Grid
                                ColumnDefinitions="Auto,*"
                                ColumnSpacing="14">

                                <Border
                                    WidthRequest="52"
                                    HeightRequest="52"
                                    BackgroundColor="{StaticResource SurfaceSecondary}"
                                    StrokeThickness="0"
                                    StrokeShape="RoundRectangle 26"
                                    VerticalOptions="Center">

                                    <Label
                                        Text="✂"
                                        FontSize="25"
                                        TextColor="{StaticResource AccentDark}"
                                        HorizontalOptions="Center"
                                        VerticalOptions="Center" />

                                </Border>


                                <VerticalStackLayout
                                    Grid.Column="1"
                                    Spacing="3"
                                    VerticalOptions="Center">

                                    <Label
                                        Text="{Binding Salon.Name}"
                                        FontSize="19"
                                        FontAttributes="Bold"
                                        TextColor="{StaticResource TextPrimary}" />

                                    <Label
                                        Text="Informacije o salonu"
                                        FontSize="12"
                                        TextColor="{StaticResource TextSecondary}" />

                                </VerticalStackLayout>

                            </Grid>


                            <!-- ADDRESS -->

                            <Border
                                BackgroundColor="{StaticResource SurfaceSecondary}"
                                StrokeThickness="0"
                                StrokeShape="RoundRectangle 14"
                                Padding="13">

                                <Grid
                                    ColumnDefinitions="Auto,*"
                                    ColumnSpacing="12">

                                    <Label
                                        Text="📍"
                                        FontSize="18"
                                        VerticalOptions="Start" />

                                    <VerticalStackLayout
                                        Grid.Column="1"
                                        Spacing="2">

                                        <Label
                                            Text="Lokacija"
                                            FontSize="11"
                                            TextColor="{StaticResource TextMuted}" />

                                        <Label
                                            Text="{Binding Salon.Address}"
                                            FontSize="15"
                                            FontAttributes="Bold"
                                            TextColor="{StaticResource TextPrimary}" />

                                        <Label
                                            Text="{Binding Salon.City}"
                                            FontSize="13"
                                            TextColor="{StaticResource TextSecondary}" />

                                    </VerticalStackLayout>

                                </Grid>

                            </Border>


                            <!-- WORKING HOURS -->

                            <VerticalStackLayout
    Spacing="9">

                                <Label
        Text="Radno vrijeme"
        FontSize="15"
        FontAttributes="Bold"
        TextColor="{StaticResource TextPrimary}" />

                                <Border
        BackgroundColor="{StaticResource SurfaceSecondary}"
        StrokeThickness="0"
        StrokeShape="RoundRectangle 14"
        Padding="13">

                                    <VerticalStackLayout
            BindableLayout.ItemsSource="{Binding Salon.WorkingHours}"
            Spacing="8">

                                        <BindableLayout.ItemTemplate>

                                            <DataTemplate
                    x:DataType="salonResponses:SalonWorkingHoursResponse">

                                                <Grid
                        ColumnDefinitions="*,Auto"
                        ColumnSpacing="12">

                                                    <!-- DAY -->

                                                    <Label
                            Text="{Binding DayName}"
                            FontSize="14"
                            TextColor="{StaticResource TextPrimary}"
                            VerticalOptions="Center" />

                                                    <!-- TIME -->

                                                    <HorizontalStackLayout
                            Grid.Column="1"
                            Spacing="5"
                            VerticalOptions="Center">

                                                        <Label
                                Text="{Binding StartsAt, StringFormat='{0:HH\\:mm}'}"
                                FontSize="14"
                                TextColor="{StaticResource TextSecondary}" />

                                                        <Label
                                Text="-"
                                FontSize="14"
                                TextColor="{StaticResource TextSecondary}" />

                                                        <Label
                                Text="{Binding EndsAt, StringFormat='{0:HH\\:mm}'}"
                                FontSize="14"
                                TextColor="{StaticResource TextSecondary}" />

                                                    </HorizontalStackLayout>

                                                </Grid>

                                            </DataTemplate>

                                        </BindableLayout.ItemTemplate>

                                    </VerticalStackLayout>

                                </Border>

                            </VerticalStackLayout>


                            <!-- SOCIAL MEDIA -->

                            <VerticalStackLayout
                                Spacing="9">

                                <Label
                                    Text="Društvene mreže"
                                    FontSize="15"
                                    FontAttributes="Bold"
                                    TextColor="{StaticResource TextPrimary}" />


                                <!-- INSTAGRAM -->

                                <Border
                                    BackgroundColor="{StaticResource SurfaceSecondary}"
                                    StrokeThickness="0"
                                    StrokeShape="RoundRectangle 14"
                                    Padding="13">

                                    <Border.GestureRecognizers>

                                        <TapGestureRecognizer
                                            Command="{Binding OpenInstagramCommand}" />

                                    </Border.GestureRecognizers>


                                    <Grid
                                        ColumnDefinitions="Auto,*,Auto"
                                        ColumnSpacing="12">

                                        <Border
                                            WidthRequest="34"
                                            HeightRequest="34"
                                            BackgroundColor="{StaticResource Background}"
                                            StrokeThickness="0"
                                            StrokeShape="RoundRectangle 10"
                                            VerticalOptions="Center">

                                            <Label
                                                Text="◎"
                                                FontSize="20"
                                                FontAttributes="Bold"
                                                TextColor="{StaticResource AccentDark}"
                                                HorizontalOptions="Center"
                                                VerticalOptions="Center" />

                                        </Border>


                                        <VerticalStackLayout
                                            Grid.Column="1"
                                            Spacing="1"
                                            VerticalOptions="Center">

                                            <Label
                                                Text="Instagram"
                                                FontSize="14"
                                                FontAttributes="Bold"
                                                TextColor="{StaticResource TextPrimary}" />

                                            <Label
                                                Text="Posjetite Instagram profil salona"
                                                FontSize="11"
                                                TextColor="{StaticResource TextSecondary}" />

                                        </VerticalStackLayout>


                                        <Label
                                            Grid.Column="2"
                                            Text="›"
                                            FontSize="28"
                                            TextColor="{StaticResource AccentDark}"
                                            VerticalOptions="Center" />

                                    </Grid>

                                </Border>


                                <!-- FACEBOOK -->

                                <Border
                                    BackgroundColor="{StaticResource SurfaceSecondary}"
                                    StrokeThickness="0"
                                    StrokeShape="RoundRectangle 14"
                                    Padding="13">

                                    <Border.GestureRecognizers>

                                        <TapGestureRecognizer
                                            Command="{Binding OpenFacebookCommand}" />

                                    </Border.GestureRecognizers>


                                    <Grid
                                        ColumnDefinitions="Auto,*,Auto"
                                        ColumnSpacing="12">

                                        <Border
                                            WidthRequest="34"
                                            HeightRequest="34"
                                            BackgroundColor="{StaticResource Background}"
                                            StrokeThickness="0"
                                            StrokeShape="RoundRectangle 10"
                                            VerticalOptions="Center">

                                            <Label
                                                Text="f"
                                                FontSize="20"
                                                FontAttributes="Bold"
                                                TextColor="{StaticResource AccentDark}"
                                                HorizontalOptions="Center"
                                                VerticalOptions="Center" />

                                        </Border>


                                        <VerticalStackLayout
                                            Grid.Column="1"
                                            Spacing="1"
                                            VerticalOptions="Center">

                                            <Label
                                                Text="Facebook"
                                                FontSize="14"
                                                FontAttributes="Bold"
                                                TextColor="{StaticResource TextPrimary}" />

                                            <Label
                                                Text="Posjetite Facebook profil salona"
                                                FontSize="11"
                                                TextColor="{StaticResource TextSecondary}" />

                                        </VerticalStackLayout>


                                        <Label
                                            Grid.Column="2"
                                            Text="›"
                                            FontSize="28"
                                            TextColor="{StaticResource AccentDark}"
                                            VerticalOptions="Center" />

                                    </Grid>

                                </Border>

                            </VerticalStackLayout>


                            <!-- SALON LOADING -->

                            <ActivityIndicator
                                IsRunning="{Binding IsLoadingSalon}"
                                IsVisible="{Binding IsLoadingSalon}"
                                HorizontalOptions="Center"
                                Color="{StaticResource AccentDark}" />

                        </VerticalStackLayout>

                    </Border>

                </VerticalStackLayout>


                <!-- SECURITY -->

                <VerticalStackLayout
                    Spacing="10">

                    <Label
                        Text="Sigurnost"
                        FontSize="20"
                        FontAttributes="Bold"
                        TextColor="{StaticResource TextPrimary}" />


                    <Border
                        BackgroundColor="{StaticResource SurfaceSecondary}"
                        StrokeThickness="0"
                        StrokeShape="RoundRectangle 18"
                        Padding="16">

                        <!-- OPEN CHANGE PASSWORD -->

                        <Border.GestureRecognizers>

                            <TapGestureRecognizer
                                Command="{Binding OpenChangePasswordCommand}" />

                        </Border.GestureRecognizers>


                        <Grid
                            ColumnDefinitions="*,Auto">

                            <VerticalStackLayout
                                Spacing="3">

                                <Label
                                    Text="Lozinka"
                                    FontSize="16"
                                    FontAttributes="Bold"
                                    TextColor="{StaticResource TextPrimary}" />

                                <Label
                                    Text="Promijenite lozinku svog naloga."
                                    FontSize="12"
                                    TextColor="{StaticResource TextSecondary}" />

                            </VerticalStackLayout>


                            <Label
                                Grid.Column="1"
                                Text="›"
                                FontSize="28"
                                TextColor="{StaticResource AccentDark}"
                                VerticalOptions="Center" />

                        </Grid>

                    </Border>

                </VerticalStackLayout>


                <!-- LOGOUT -->

                <Button
                    Text="ODJAVI SE"
                    Command="{Binding LogoutCommand}"
                    BackgroundColor="{StaticResource Surface}"
                    BorderColor="{StaticResource Border}"
                    BorderWidth="1"
                    TextColor="{StaticResource TextPrimary}"
                    FontAttributes="Bold"
                    FontSize="14"
                    HeightRequest="52"
                    CornerRadius="14"
                    Margin="0,6,0,0" />


                <!-- LOADING -->

                <ActivityIndicator
                    IsRunning="{Binding IsLoading}"
                    IsVisible="{Binding IsLoading}"
                    HorizontalOptions="Center"
                    Margin="0,4,0,0" />

                <ActivityIndicator
                    IsRunning="{Binding IsSaving}"
                    IsVisible="{Binding IsSaving}"
                    HorizontalOptions="Center"
                    Margin="0,4,0,0" />

            </VerticalStackLayout>

        </ScrollView>

    </Grid>

</ContentPage>