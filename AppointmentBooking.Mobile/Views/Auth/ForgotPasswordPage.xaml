<?xml version="1.0" encoding="utf-8" ?>

<ContentPage
    x:Class="AppointmentBooking.Mobile.Views.Auth.ForgotPasswordPage"
    xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
    xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
    xmlns:viewModels="clr-namespace:AppointmentBooking.Mobile.ViewModels.Auth"
    x:DataType="viewModels:ForgotPasswordViewModel"
    BackgroundColor="{StaticResource Background}"
    Shell.NavBarIsVisible="False"
    SafeAreaEdges="All">

    <ScrollView>

        <VerticalStackLayout
            Padding="24,50,24,30"
            Spacing="22">

            <!-- HEADER -->

            <VerticalStackLayout
                Spacing="8">

                <Label
                    Text="Zaboravljena lozinka"
                    FontSize="30"
                    FontAttributes="Bold"
                    TextColor="{StaticResource TextPrimary}" />

                <Label
                    Text="Pratite korake kako biste promijenili lozinku svog naloga."
                    FontSize="15"
                    LineBreakMode="WordWrap"
                    TextColor="{StaticResource TextSecondary}" />

            </VerticalStackLayout>


            <!-- PROGRESS -->

            <Grid
                ColumnDefinitions="Auto,*,Auto,*,Auto"
                ColumnSpacing="8"
                Margin="0,2,0,2">

                <!-- STEP 1 -->

                <VerticalStackLayout
                    Grid.Column="0"
                    Spacing="5"
                    HorizontalOptions="Center">

                    <Border
                        WidthRequest="36"
                        HeightRequest="36"
                        StrokeThickness="0"
                        StrokeShape="RoundRectangle 18"
                        BackgroundColor="{StaticResource Primary}">

                        <Label
                            Text="●"
                            FontSize="14"
                            FontAttributes="Bold"
                            TextColor="{StaticResource TextOnPrimary}"
                            HorizontalOptions="Center"
                            VerticalOptions="Center">

                            <Label.Triggers>

                                <!-- Email je završen -->
                                <DataTrigger
                                    TargetType="Label"
                                    Binding="{Binding IsCodeStep}"
                                    Value="True">

                                    <Setter
                                        Property="Text"
                                        Value="✓" />

                                </DataTrigger>

                                <DataTrigger
                                    TargetType="Label"
                                    Binding="{Binding IsPasswordStep}"
                                    Value="True">

                                    <Setter
                                        Property="Text"
                                        Value="✓" />

                                </DataTrigger>

                            </Label.Triggers>

                        </Label>

                    </Border>

                    <Label
                        Text="Email"
                        FontSize="11"
                        FontAttributes="Bold"
                        TextColor="{StaticResource TextPrimary}"
                        HorizontalTextAlignment="Center" />

                </VerticalStackLayout>


                <!-- LINE 1 -->

                <BoxView
                    Grid.Column="1"
                    HeightRequest="3"
                    Color="{StaticResource Border}"
                    VerticalOptions="Start"
                    Margin="0,17,0,0">

                    <BoxView.Triggers>

                        <DataTrigger
                            TargetType="BoxView"
                            Binding="{Binding IsCodeStep}"
                            Value="True">

                            <Setter
                                Property="Color"
                                Value="{StaticResource Primary}" />

                        </DataTrigger>

                        <DataTrigger
                            TargetType="BoxView"
                            Binding="{Binding IsPasswordStep}"
                            Value="True">

                            <Setter
                                Property="Color"
                                Value="{StaticResource Primary}" />

                        </DataTrigger>

                    </BoxView.Triggers>

                </BoxView>


                <!-- STEP 2 -->

                <VerticalStackLayout
                    Grid.Column="2"
                    Spacing="5"
                    HorizontalOptions="Center">

                    <Border
                        WidthRequest="36"
                        HeightRequest="36"
                        StrokeThickness="0"
                        StrokeShape="RoundRectangle 18"
                        BackgroundColor="{StaticResource SurfaceSecondary}">

                        <Label
                            Text="○"
                            FontSize="18"
                            FontAttributes="Bold"
                            TextColor="{StaticResource TextSecondary}"
                            HorizontalOptions="Center"
                            VerticalOptions="Center">

                            <Label.Triggers>

                                <!-- Trenutni korak -->
                                <DataTrigger
                                    TargetType="Label"
                                    Binding="{Binding IsCodeStep}"
                                    Value="True">

                                    <Setter
                                        Property="Text"
                                        Value="●" />

                                    <Setter
                                        Property="TextColor"
                                        Value="{StaticResource TextOnPrimary}" />

                                </DataTrigger>

                                <!-- Kod je završen -->
                                <DataTrigger
                                    TargetType="Label"
                                    Binding="{Binding IsPasswordStep}"
                                    Value="True">

                                    <Setter
                                        Property="Text"
                                        Value="✓" />

                                    <Setter
                                        Property="TextColor"
                                        Value="{StaticResource TextOnPrimary}" />

                                </DataTrigger>

                            </Label.Triggers>

                        </Label>

                        <Border.Triggers>

                            <!-- Aktivni kod -->
                            <DataTrigger
                                TargetType="Border"
                                Binding="{Binding IsCodeStep}"
                                Value="True">

                                <Setter
                                    Property="BackgroundColor"
                                    Value="{StaticResource Primary}" />

                            </DataTrigger>

                            <!-- Kod završen -->
                            <DataTrigger
                                TargetType="Border"
                                Binding="{Binding IsPasswordStep}"
                                Value="True">

                                <Setter
                                    Property="BackgroundColor"
                                    Value="{StaticResource Primary}" />

                            </DataTrigger>

                        </Border.Triggers>

                    </Border>

                    <Label
                        Text="Kod"
                        FontSize="11"
                        FontAttributes="Bold"
                        TextColor="{StaticResource TextSecondary}"
                        HorizontalTextAlignment="Center">

                        <Label.Triggers>

                            <DataTrigger
                                TargetType="Label"
                                Binding="{Binding IsCodeStep}"
                                Value="True">

                                <Setter
                                    Property="TextColor"
                                    Value="{StaticResource TextPrimary}" />

                            </DataTrigger>

                            <DataTrigger
                                TargetType="Label"
                                Binding="{Binding IsPasswordStep}"
                                Value="True">

                                <Setter
                                    Property="TextColor"
                                    Value="{StaticResource TextPrimary}" />

                            </DataTrigger>

                        </Label.Triggers>

                    </Label>

                </VerticalStackLayout>


                <!-- LINE 2 -->

                <BoxView
                    Grid.Column="3"
                    HeightRequest="3"
                    Color="{StaticResource Border}"
                    VerticalOptions="Start"
                    Margin="0,17,0,0">

                    <BoxView.Triggers>

                        <DataTrigger
                            TargetType="BoxView"
                            Binding="{Binding IsPasswordStep}"
                            Value="True">

                            <Setter
                                Property="Color"
                                Value="{StaticResource Primary}" />

                        </DataTrigger>

                    </BoxView.Triggers>

                </BoxView>


                <!-- STEP 3 -->

                <VerticalStackLayout
                    Grid.Column="4"
                    Spacing="5"
                    HorizontalOptions="Center">

                    <Border
                        WidthRequest="36"
                        HeightRequest="36"
                        StrokeThickness="0"
                        StrokeShape="RoundRectangle 18"
                        BackgroundColor="{StaticResource SurfaceSecondary}">

                        <Label
                            Text="○"
                            FontSize="18"
                            FontAttributes="Bold"
                            TextColor="{StaticResource TextSecondary}"
                            HorizontalOptions="Center"
                            VerticalOptions="Center">

                            <Label.Triggers>

                                <DataTrigger
                                    TargetType="Label"
                                    Binding="{Binding IsPasswordStep}"
                                    Value="True">

                                    <Setter
                                        Property="Text"
                                        Value="●" />

                                    <Setter
                                        Property="TextColor"
                                        Value="{StaticResource TextOnPrimary}" />

                                </DataTrigger>

                            </Label.Triggers>

                        </Label>

                        <Border.Triggers>

                            <DataTrigger
                                TargetType="Border"
                                Binding="{Binding IsPasswordStep}"
                                Value="True">

                                <Setter
                                    Property="BackgroundColor"
                                    Value="{StaticResource Primary}" />

                            </DataTrigger>

                        </Border.Triggers>

                    </Border>

                    <Label
                        Text="Lozinka"
                        FontSize="11"
                        FontAttributes="Bold"
                        TextColor="{StaticResource TextSecondary}"
                        HorizontalTextAlignment="Center">

                        <Label.Triggers>

                            <DataTrigger
                                TargetType="Label"
                                Binding="{Binding IsPasswordStep}"
                                Value="True">

                                <Setter
                                    Property="TextColor"
                                    Value="{StaticResource TextPrimary}" />

                            </DataTrigger>

                        </Label.Triggers>

                    </Label>

                </VerticalStackLayout>

            </Grid>


            <!-- STEP 1 : EMAIL -->

            <VerticalStackLayout
                IsVisible="{Binding IsEmailStep}"
                Spacing="18">

                <Border
                    BackgroundColor="{StaticResource Surface}"
                    Stroke="{StaticResource Border}"
                    StrokeThickness="1"
                    StrokeShape="RoundRectangle 16"
                    Padding="16">

                    <VerticalStackLayout
                        Spacing="6">

                        <Label
                            Text="Email adresa"
                            FontSize="12"
                            FontAttributes="Bold"
                            TextColor="{StaticResource TextSecondary}" />

                        <Entry
                            Text="{Binding Email}"
                            Placeholder="npr. korisnik@email.com"
                            Keyboard="Email"
                            FontSize="16"
                            TextColor="{StaticResource TextPrimary}"
                            PlaceholderColor="{StaticResource TextMuted}"
                            BackgroundColor="Transparent"
                            ReturnType="Done"
                            ReturnCommand="{Binding SendCodeCommand}" />

                    </VerticalStackLayout>

                </Border>

                <Button
                    Text="POŠALJI KOD"
                    Command="{Binding SendCodeCommand}"
                    IsEnabled="{Binding CanSubmitEmail}"
                    HeightRequest="54"
                    CornerRadius="14"
                    FontSize="15"
                    FontAttributes="Bold"
                    BackgroundColor="{StaticResource Primary}"
                    TextColor="{StaticResource TextOnPrimary}" />

            </VerticalStackLayout>


            <!-- STEP 2 : CODE -->

            <VerticalStackLayout
                IsVisible="{Binding IsCodeStep}"
                Spacing="18">

                <Border
                    BackgroundColor="{StaticResource Surface}"
                    Stroke="{StaticResource Border}"
                    StrokeThickness="1"
                    StrokeShape="RoundRectangle 16"
                    Padding="16">

                    <VerticalStackLayout
                        Spacing="8">

                        <Label
                            Text="Kod za potvrdu"
                            FontSize="12"
                            FontAttributes="Bold"
                            TextColor="{StaticResource TextSecondary}" />

                        <Label
                            Text="Unesite šestocifreni kod koji smo poslali na vaš email."
                            FontSize="14"
                            LineBreakMode="WordWrap"
                            TextColor="{StaticResource TextSecondary}" />

                        <Entry
                            Text="{Binding Code}"
                            Placeholder="000000"
                            Keyboard="Numeric"
                            MaxLength="6"
                            FontSize="24"
                            HorizontalTextAlignment="Center"
                            TextColor="{StaticResource TextPrimary}"
                            PlaceholderColor="{StaticResource TextMuted}"
                            BackgroundColor="Transparent"
                            ReturnType="Done"
                            ReturnCommand="{Binding VerifyCodeCommand}" />

                    </VerticalStackLayout>

                </Border>

                <Button
                    Text="POTVRDI KOD"
                    Command="{Binding VerifyCodeCommand}"
                    IsEnabled="{Binding CanSubmitCode}"
                    HeightRequest="54"
                    CornerRadius="14"
                    FontSize="15"
                    FontAttributes="Bold"
                    BackgroundColor="{StaticResource Primary}"
                    TextColor="{StaticResource TextOnPrimary}" />

                <Button
                    Text="Nazad"
                    Command="{Binding BackToEmailCommand}"
                    BackgroundColor="Transparent"
                    TextColor="{StaticResource AccentDark}"
                    FontSize="14"
                    FontAttributes="Bold"
                    HeightRequest="44" />

            </VerticalStackLayout>


            <!-- STEP 3 : NEW PASSWORD -->

            <VerticalStackLayout
                IsVisible="{Binding IsPasswordStep}"
                Spacing="18">

                <Border
                    BackgroundColor="{StaticResource Surface}"
                    Stroke="{StaticResource Border}"
                    StrokeThickness="1"
                    StrokeShape="RoundRectangle 16"
                    Padding="16">

                    <VerticalStackLayout
                        Spacing="6">

                        <Label
                            Text="Nova lozinka"
                            FontSize="12"
                            FontAttributes="Bold"
                            TextColor="{StaticResource TextSecondary}" />

                        <Entry
                            Text="{Binding NewPassword}"
                            Placeholder="Unesite novu lozinku"
                            IsPassword="True"
                            FontSize="16"
                            TextColor="{StaticResource TextPrimary}"
                            PlaceholderColor="{StaticResource TextMuted}"
                            BackgroundColor="Transparent" />

                    </VerticalStackLayout>

                </Border>


                <Border
                    BackgroundColor="{StaticResource Surface}"
                    Stroke="{StaticResource Border}"
                    StrokeThickness="1"
                    StrokeShape="RoundRectangle 16"
                    Padding="16">

                    <VerticalStackLayout
                        Spacing="6">

                        <Label
                            Text="Potvrda nove lozinke"
                            FontSize="12"
                            FontAttributes="Bold"
                            TextColor="{StaticResource TextSecondary}" />

                        <Entry
                            Text="{Binding ConfirmPassword}"
                            Placeholder="Ponovite novu lozinku"
                            IsPassword="True"
                            FontSize="16"
                            TextColor="{StaticResource TextPrimary}"
                            PlaceholderColor="{StaticResource TextMuted}"
                            BackgroundColor="Transparent"
                            ReturnType="Done"
                            ReturnCommand="{Binding ResetPasswordCommand}" />

                    </VerticalStackLayout>

                </Border>


                <Button
                    Text="PROMIJENI LOZINKU"
                    Command="{Binding ResetPasswordCommand}"
                    IsEnabled="{Binding CanResetPassword}"
                    HeightRequest="54"
                    CornerRadius="14"
                    FontSize="15"
                    FontAttributes="Bold"
                    BackgroundColor="{StaticResource Primary}"
                    TextColor="{StaticResource TextOnPrimary}" />

                <Button
                    Text="Nazad na kod"
                    Command="{Binding BackToCodeCommand}"
                    BackgroundColor="Transparent"
                    TextColor="{StaticResource AccentDark}"
                    FontSize="14"
                    FontAttributes="Bold"
                    HeightRequest="44" />

            </VerticalStackLayout>


            <!-- LOADING -->

            <ActivityIndicator
                IsRunning="{Binding IsBusy}"
                IsVisible="{Binding IsBusy}"
                Color="{StaticResource Primary}"
                HorizontalOptions="Center" />


            <!-- BACK TO LOGIN -->

            <Button
                Text="Nazad na prijavu"
                Command="{Binding BackToLoginCommand}"
                BackgroundColor="Transparent"
                TextColor="{StaticResource AccentDark}"
                FontSize="14"
                FontAttributes="Bold"
                HeightRequest="44" />

        </VerticalStackLayout>

    </ScrollView>

</ContentPage>