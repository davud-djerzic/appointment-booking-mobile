<?xml version="1.0" encoding="utf-8" ?>

<ContentPage
    xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
    xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
    xmlns:viewModels="clr-namespace:AppointmentBooking.Mobile.ViewModels.Auth"
    x:Class="AppointmentBooking.Mobile.Views.Auth.LoginPage"
    x:DataType="viewModels:LoginViewModel"
    Title="Prijava"
    Shell.NavBarIsVisible="False"
    BackgroundColor="{StaticResource BrandBackground}"
    SafeAreaEdges="All">

    <ScrollView>
        <Grid
            Padding="24,24,24,30"
            RowDefinitions="Auto,Auto,Auto,Auto,Auto"
            RowSpacing="26">

            <!-- BRAND -->

            <VerticalStackLayout
                Grid.Row="0"
                Spacing="0"
                HorizontalOptions="Center">

                <Image
                    Source="slika.jpg"
                    WidthRequest="180"
                    HeightRequest="180"
                    Aspect="AspectFit"
                    HorizontalOptions="Center"
                    SemanticProperties.Description="Logo Koteša barbershop" />

            </VerticalStackLayout>


            <!-- WELCOME -->

            <VerticalStackLayout
                Grid.Row="1"
                Spacing="8">
                
                <Label
                    Text="Prijavite se na svoj račun i rezervišite termin."
                    Style="{StaticResource SubtitleLabel}"
                    TextColor="{StaticResource TextOnBrandBackground}" />

            </VerticalStackLayout>


            <!-- FORM -->

            <VerticalStackLayout
                Grid.Row="2"
                Spacing="16">

                <!-- EMAIL -->

                <Border
                    BackgroundColor="{StaticResource TextBoxBackground}"
                    Stroke="{StaticResource Border}"
                    StrokeThickness="1"
                    StrokeShape="RoundRectangle 16"
                    Padding="16,8">

                    <Grid ColumnDefinitions="*,Auto" ColumnSpacing="8">

                        <VerticalStackLayout
                            Grid.Column="0"
                            Spacing="0">

                            <Label
                                Text="Email adresa"
                                Style="{StaticResource CaptionLabel}"
                                TextColor="#68562C" />

                            <Entry
                                Placeholder="npr. korisnik@email.com"
                                Keyboard="Email"
                                Text="{Binding Email}"
                                TextColor="{StaticResource TextPrimary}"
                                PlaceholderColor="#75643C"
                                BackgroundColor="{StaticResource TextBoxBackground}"
                                FontSize="15"
                                HeightRequest="52"
                                Margin="-4,0,0,0" />           

                        </VerticalStackLayout>

                    </Grid>

                </Border>


                <!-- PASSWORD -->

                <Border
                    BackgroundColor="{StaticResource TextBoxBackground}"
                    Stroke="{StaticResource Border}"
                    StrokeThickness="1"
                    StrokeShape="RoundRectangle 16"
                    Padding="16,8">

                    <Grid ColumnDefinitions="*,Auto" ColumnSpacing="8">

                        <VerticalStackLayout Grid.Column="0" Spacing="0">
                            <Label
                                Text="Lozinka"
                                Style="{StaticResource CaptionLabel}"
                                TextColor="#68562C" />

                            <Entry
                                Placeholder="Unesite lozinku"
                                IsPassword="{Binding IsPasswordHidden}"
                                Text="{Binding Password}"
                                TextColor="{StaticResource TextPrimary}"
                                PlaceholderColor="#75643C"
                                BackgroundColor="{StaticResource TextBoxBackground}"
                                FontSize="15"
                                HeightRequest="52"
                                Margin="-4,0,0,0"
                                ReturnType="Done" />
                        </VerticalStackLayout>

                        <ImageButton
                            Grid.Column="1"
                            Source="{Binding PasswordVisibilityIcon}"
                            Command="{Binding TogglePasswordVisibilityCommand}"
                            BackgroundColor="Transparent"
                            WidthRequest="34"
                            HeightRequest="40"
                            Padding="7"
                            Aspect="AspectFit"
                            VerticalOptions="Center"
                            SemanticProperties.Description="Prikaži ili sakrij lozinku" />

                    </Grid>
                </Border>

            </VerticalStackLayout>


            <!-- ACTIONS -->

            <VerticalStackLayout
                Grid.Row="3"
                Spacing="16">

                <Button
                    Text="ZABORAVILI STE LOZINKU?"
                    BackgroundColor="Transparent"
                    Command="{Binding GoToForgotPasswordCommand}"
                    TextColor="{StaticResource BrandButton}"
                    FontSize="13"
                    FontAttributes="Bold"
                    HorizontalOptions="End"
                    Padding="0"
                    HeightRequest="32"
                    Margin="0,-12,0,0" />

                <Button
                    Text="PRIJAVI SE"
                    Style="{StaticResource PrimaryButton}"
                    BackgroundColor="{StaticResource BrandButton}"
                    TextColor="{StaticResource BrandBackground}"
                    BorderColor="{StaticResource BrandButton}"
                    BorderWidth="0"
                    Command="{Binding LoginCommand}"
                    HorizontalOptions="Fill" />  

                <ActivityIndicator
                    IsRunning="{Binding IsBusy}"
                    IsVisible="{Binding IsBusy}"
                    Color="{StaticResource BrandButton}"
                    HorizontalOptions="Center"
                    SemanticProperties.Description="Prijava je u toku" />

            </VerticalStackLayout>


            <!-- REGISTER -->

            <VerticalStackLayout
                Grid.Row="4"
                Spacing="18"
                HorizontalOptions="Fill">

                <BoxView
                    HeightRequest="1"
                    BackgroundColor="{StaticResource Border}" />

                <HorizontalStackLayout
                    HorizontalOptions="Center"
                    Spacing="5">

                    <Label
                        Text="Nemate račun?"
                        Style="{StaticResource CaptionLabel}"
                        TextColor="{StaticResource TextOnBrandBackground}"
                        VerticalOptions="Center" />

                    <Button
                        Text="Registrujte se"
                        Command="{Binding GoToRegisterCommand}"
                        BackgroundColor="Transparent"
                        TextColor="{StaticResource BrandButton}"
                        FontSize="13"
                        FontAttributes="Bold"
                        Padding="0"
                        HeightRequest="30" />

                </HorizontalStackLayout>

                <VerticalStackLayout
                    Spacing="4"
                    HorizontalOptions="Center">

                <Label
                    Text="LJEPOTA POČINJE"
                    FontSize="10"
                    CharacterSpacing="3"
                    TextColor="{StaticResource TextOnBrandBackground}"
                        HorizontalOptions="Center" />

                    <Label
                        Text="BRIGOM O SEBI"
                        FontSize="10"
                        CharacterSpacing="3"
                    TextColor="{StaticResource TextOnBrandBackground}"
                        HorizontalOptions="Center" />

                </VerticalStackLayout>

            </VerticalStackLayout>

        </Grid>
    </ScrollView>

</ContentPage>
