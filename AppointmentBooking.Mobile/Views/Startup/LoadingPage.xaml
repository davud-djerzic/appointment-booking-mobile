<?xml version="1.0" encoding="utf-8" ?>

<ContentPage
    xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
    xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
    x:Class="AppointmentBooking.Mobile.Views.Startup.LoadingPage"
    BackgroundColor="{StaticResource BrandBackground}"
    Shell.NavBarIsVisible="False"
    SafeAreaEdges="None">

    <!-- Startup panel: salon logo on the app background, shown for ~2 s (AppShell). -->
    <Grid>

        <Border
            WidthRequest="240"
            HeightRequest="240"
            StrokeThickness="0"
            StrokeShape="RoundRectangle 32"
            BackgroundColor="{StaticResource BrandBackground}"
            HorizontalOptions="Center"
            VerticalOptions="Center">

            <Image
                Source="salon.jpg"
                Aspect="AspectFill"
                SemanticProperties.Description="Logo salona" />

        </Border>

    </Grid>

</ContentPage>
