<?xml version="1.0" encoding="utf-8" ?>

<ContentPage
    x:Class="AppointmentBooking.Mobile.Views.Booking.BookingPage"
    xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
    xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
    xmlns:viewModels="clr-namespace:AppointmentBooking.Mobile.ViewModels.Booking"
    xmlns:serviceModels="clr-namespace:AppointmentBooking.Mobile.Models.BookableServices"
    xmlns:bookingResponses="clr-namespace:AppointmentBooking.Mobile.Models.Bookings.Responses"
    xmlns:toolkit="http://schemas.microsoft.com/dotnet/2022/maui/toolkit"
    x:Name="RootPage"
    x:DataType="viewModels:BookingViewModel"
    BackgroundColor="{StaticResource BrandBackground}"
    Shell.NavBarIsVisible="False"
    SafeAreaEdges="All">

    <ContentPage.Behaviors>
        <toolkit:EventToCommandBehavior
            EventName="Appearing"
            Command="{Binding Source={x:Reference RootPage}, Path=BindingContext.LoadServicesCommand}" />
    </ContentPage.Behaviors>

    <Grid
        RowDefinitions="Auto,*"
        Padding="20,18,20,16">

        <!-- HEADER -->

        <VerticalStackLayout
            Grid.Row="0"
            Spacing="5"
            Margin="0,0,0,18">

            <Label
                Text="Rezerviši termin"
                FontSize="28"
                FontAttributes="Bold"
                TextColor="{StaticResource TextOnBrandBackground}" />

            <Label
                Text="Odaberite usluge i datum."
                FontSize="14"
                TextColor="{StaticResource TextOnBrandBackground}" />

            <!-- EMPLOYEE -->

            <Border
                BackgroundColor="{StaticResource QuickBookingPanelBackground}"
                Stroke="{StaticResource PanelBorder}"
                StrokeThickness="0.8"
                StrokeShape="RoundRectangle 14"
                Padding="14,10"
                Margin="0,6,0,0">

                <VerticalStackLayout
                    Spacing="4">

                    <Grid
                        ColumnDefinitions="Auto,*">

                        <Label
                            Text="Termin kod:"
                            FontSize="13"
                            TextColor="{StaticResource TextOnBrandBackground}"
                            Opacity="0.8"
                            VerticalOptions="Center" />

                        <Label
                            Grid.Column="1"
                            Text="{Binding EmployeeName}"
                            FontSize="14"
                            FontAttributes="Bold"
                            TextColor="{StaticResource BrandButton}"
                            HorizontalOptions="End"
                            VerticalOptions="Center" />

                    </Grid>

                    <Label
                        Text="Za odabrane usluge trenutno nema dostupnog zaposlenika."
                        FontSize="12"
                        TextColor="{StaticResource Warning}"
                        IsVisible="{Binding IsEmployeeUnavailable}" />

                </VerticalStackLayout>

            </Border>

        </VerticalStackLayout>


        <!-- CONTENT -->

        <ScrollView
            x:Name="BookingScrollView"
            Grid.Row="1">

            <VerticalStackLayout
                Spacing="18">

                <!-- SERVICES -->

                <VerticalStackLayout
                    Spacing="10">

                    <Label
                        Text="Odaberite usluge"
                        FontSize="19"
                        FontAttributes="Bold"
                        TextColor="{StaticResource TextOnBrandBackground}" />

                    <CollectionView
                        ItemsSource="{Binding ServiceItems}"
                        SelectionMode="None">

                        <CollectionView.ItemTemplate>

                            <DataTemplate
                                x:DataType="serviceModels:ServiceSelectionItem">

                                <Border
                                    BackgroundColor="{StaticResource QuickBookingPanelBackground}"
                                    Stroke="{StaticResource PanelBorder}"
                                    StrokeThickness="0.8"
                                    StrokeShape="RoundRectangle 16"
                                    Padding="14,12"
                                    Margin="0,0,0,10">

                                    <Border.Triggers>
                                        <DataTrigger
                                            TargetType="Border"
                                            Binding="{Binding IsSelected}"
                                            Value="True">
                                            <Setter
                                                Property="Stroke"
                                                Value="{StaticResource BrandButton}" />
                                            <Setter
                                                Property="StrokeThickness"
                                                Value="1.5" />
                                        </DataTrigger>
                                    </Border.Triggers>

                                    <Grid
                                        ColumnDefinitions="*,Auto"
                                        RowDefinitions="Auto,Auto">

                                        <Label
                                            Grid.Row="0"
                                            Text="{Binding Service.Name}"
                                            FontSize="16"
                                            FontAttributes="Bold"
                                            TextColor="{StaticResource TextOnBrandBackground}"
                                            VerticalOptions="Center" />

                                        <CheckBox
                                            Grid.Row="0"
                                            Grid.Column="1"
                                            IsChecked="{Binding IsSelected, Mode=TwoWay}"
                                            Color="{StaticResource BrandButton}"
                                            VerticalOptions="Center" />

                                        <Grid
                                            Grid.Row="1"
                                            Grid.ColumnSpan="2"
                                            ColumnDefinitions="Auto,*"
                                            Margin="0,8,0,0">

                                            <Border
                                                BackgroundColor="{StaticResource BrandButton}"
                                                StrokeThickness="0"
                                                StrokeShape="RoundRectangle 9"
                                                Padding="7,3"
                                                VerticalOptions="Center">

                                                <Label
                                                    Text="{Binding Service.DurationMinutes, StringFormat='{}{0} min'}"
                                                    FontSize="11"
                                                    FontAttributes="Bold"
                                                    TextColor="{StaticResource BrandBackground}"
                                                    VerticalOptions="Center" />

                                            </Border>

                                            <Label
                                                Grid.Column="1"
                                                Text="{Binding Service.Price, StringFormat='{}{0:0.00} KM'}"
                                                FontSize="15"
                                                FontAttributes="Bold"
                                                TextColor="{StaticResource BrandButton}"
                                                HorizontalTextAlignment="End"
                                                VerticalOptions="Center" />

                                        </Grid>

                                    </Grid>

                                </Border>

                            </DataTemplate>

                        </CollectionView.ItemTemplate>

                    </CollectionView>

                </VerticalStackLayout>


                <!-- SUMMARY -->

                <Border
                    BackgroundColor="{StaticResource QuickBookingPanelBackground}"
                    Stroke="{StaticResource PanelBorder}"
                    StrokeThickness="0.8"
                    StrokeShape="RoundRectangle 16"
                    Padding="16,14">

                    <VerticalStackLayout Spacing="8">

                        <Grid ColumnDefinitions="*,Auto">

                            <Label
                                Text="Odabrane usluge"
                                FontSize="13"
                                TextColor="{StaticResource TextOnBrandBackground}"
                                Opacity="0.8" />

                            <Label
                                Grid.Column="1"
                                Text="{Binding SelectedServiceCount}"
                                FontSize="13"
                                FontAttributes="Bold"
                                TextColor="{StaticResource TextOnBrandBackground}" />

                        </Grid>

                        <Grid ColumnDefinitions="*,Auto">

                            <Label
                                Text="Trajanje"
                                FontSize="13"
                                TextColor="{StaticResource TextOnBrandBackground}"
                                Opacity="0.8" />

                            <Label
                                Grid.Column="1"
                                Text="{Binding TotalDurationMinutes, StringFormat='{}{0} min'}"
                                FontSize="13"
                                FontAttributes="Bold"
                                TextColor="{StaticResource TextOnBrandBackground}" />

                        </Grid>

                        <BoxView
                            HeightRequest="0.8"
                            Color="{StaticResource PanelBorder}"
                            Margin="0,2" />

                        <Grid ColumnDefinitions="*,Auto">

                            <Label
                                Text="Ukupna cijena"
                                FontSize="14"
                                FontAttributes="Bold"
                                TextColor="{StaticResource TextOnBrandBackground}"
                                VerticalOptions="Center" />

                            <Label
                                Grid.Column="1"
                                Text="{Binding TotalPrice, StringFormat='{}{0:0.00} KM'}"
                                FontSize="18"
                                FontAttributes="Bold"
                                TextColor="{StaticResource BrandButton}"
                                VerticalOptions="Center" />

                        </Grid>

                    </VerticalStackLayout>

                </Border>


                <!-- CALENDAR -->

                <VerticalStackLayout
                    Spacing="12">

                    <Label
                        Text="Odaberite datum"
                        FontSize="19"
                        FontAttributes="Bold"
                        TextColor="{StaticResource TextOnBrandBackground}" />

                    <!-- MONTH NAVIGATION -->

                    <Grid
                        ColumnDefinitions="Auto,*,Auto">

                        <Button
                            Grid.Column="0"
                            Text="‹"
                            Command="{Binding PreviousMonthCommand}"
                            WidthRequest="44"
                            HeightRequest="44"
                            Padding="0"
                            FontSize="24"
                            BackgroundColor="{StaticResource BrandButton}"
                            TextColor="{StaticResource BrandBackground}"
                            FontAttributes="Bold"
                            CornerRadius="12" />

                        <Label
                            Grid.Column="1"
                            Text="{Binding DisplayedMonthTitle}"
                            FontSize="17"
                            FontAttributes="Bold"
                            TextColor="{StaticResource TextOnBrandBackground}"
                            HorizontalOptions="Center"
                            VerticalOptions="Center" />

                        <Button
                            Grid.Column="2"
                            Text="›"
                            Command="{Binding NextMonthCommand}"
                            WidthRequest="44"
                            HeightRequest="44"
                            Padding="0"
                            FontSize="24"
                            BackgroundColor="{StaticResource BrandButton}"
                            TextColor="{StaticResource BrandBackground}"
                            FontAttributes="Bold"
                            CornerRadius="12" />

                    </Grid>


                    <!-- WEEK DAYS -->

                    <Grid
                        ColumnDefinitions="*,*,*,*,*"
                        Padding="2,0">

                        <Label
                            Text="Po"
                            HorizontalOptions="Center"
                            FontSize="11"
                            FontAttributes="Bold"
                            TextColor="{StaticResource TextOnBrandBackground}" />

                        <Label
                            Grid.Column="1"
                            Text="Ut"
                            HorizontalOptions="Center"
                            FontSize="11"
                            FontAttributes="Bold"
                            TextColor="{StaticResource TextOnBrandBackground}" />

                        <Label
                            Grid.Column="2"
                            Text="Sr"
                            HorizontalOptions="Center"
                            FontSize="11"
                            FontAttributes="Bold"
                            TextColor="{StaticResource TextOnBrandBackground}" />

                        <Label
                            Grid.Column="3"
                            Text="Če"
                            HorizontalOptions="Center"
                            FontSize="11"
                            FontAttributes="Bold"
                            TextColor="{StaticResource TextOnBrandBackground}" />

                        <Label
                            Grid.Column="4"
                            Text="Pe"
                            HorizontalOptions="Center"
                            FontSize="11"
                            FontAttributes="Bold"
                            TextColor="{StaticResource TextOnBrandBackground}" />

                    </Grid>


                    <!-- CALENDAR DAYS -->

                    <CollectionView
                        ItemsSource="{Binding CalendarDays}"
                        SelectionMode="None">

                        <CollectionView.ItemsLayout>

                            <GridItemsLayout
                                Orientation="Vertical"
                                Span="5"
                                HorizontalItemSpacing="5"
                                VerticalItemSpacing="5" />

                        </CollectionView.ItemsLayout>

                        <CollectionView.ItemTemplate>

                            <DataTemplate
                                x:DataType="viewModels:CalendarDayItem">

                                <Border
                                    Padding="0"
                                    StrokeThickness="1"
                                    Stroke="{StaticResource PanelBorder}"
                                    StrokeShape="RoundRectangle 12"
                                    BackgroundColor="{StaticResource QuickBookingPanelBackground}">

                                    <Border.Triggers>

                                        <DataTrigger
                                            TargetType="Border"
                                            Binding="{Binding IsSelected}"
                                            Value="True">

                                            <Setter
                                                Property="BackgroundColor"
                                                Value="{StaticResource BrandButton}" />

                                            <Setter
                                                Property="Stroke"
                                                Value="{StaticResource BrandButton}" />

                                        </DataTrigger>

                                        <DataTrigger
                                            TargetType="Border"
                                            Binding="{Binding IsSelectable}"
                                            Value="False">

                                            <Setter
                                                Property="Opacity"
                                                Value="0.35" />

                                            <Setter
                                                Property="BackgroundColor"
                                                Value="Transparent" />

                                        </DataTrigger>

                                    </Border.Triggers>

                                    <Button
                                        Text="{Binding DayNumber}"
                                        Clicked="OnCalendarDateClicked"
                                        HeightRequest="42"
                                        BackgroundColor="Transparent"
                                        TextColor="{StaticResource TextOnBrandBackground}"
                                        FontAttributes="Bold"
                                        IsEnabled="{Binding IsSelectable}"
                                        Padding="0">

                                        <Button.Triggers>

                                            <DataTrigger
                                                TargetType="Button"
                                                Binding="{Binding IsSelected}"
                                                Value="True">

                                                <Setter
                                                    Property="TextColor"
                                                    Value="{StaticResource BrandBackground}" />

                                            </DataTrigger>

                                        </Button.Triggers>

                                    </Button>

                                </Border>

                            </DataTemplate>

                        </CollectionView.ItemTemplate>

                    </CollectionView>


                    <!-- AVAILABLE TIMES -->

                    <VerticalStackLayout
                        Spacing="12"
                        VerticalOptions="Start">

                        <Label
                            Text="Slobodni termini"
                            FontSize="19"
                            FontAttributes="Bold"
                            TextColor="{StaticResource TextOnBrandBackground}" />

                        <Border
                            HeightRequest="285"
                        BackgroundColor="{StaticResource QuickBookingPanelBackground}"
                        Stroke="{StaticResource PanelBorder}"
                        StrokeThickness="0.8"
                        StrokeShape="RoundRectangle 14"
                            Padding="12">

                            <Grid>
                                <ActivityIndicator
                                    IsRunning="{Binding IsLoadingAvailability}"
                                    IsVisible="{Binding IsLoadingAvailability}"
                                    Color="{StaticResource BrandButton}"
                                    HorizontalOptions="Center"
                                    VerticalOptions="Center"
                                    SemanticProperties.Description="Učitavanje slobodnih termina" />

                                <Label
                                    Text="Odaberite usluge i datum za prikaz termina."
                                    FontSize="14"
                                    TextColor="{StaticResource TextOnBrandBackground}"
                                    HorizontalTextAlignment="Center"
                                    VerticalTextAlignment="Center"
                                    IsVisible="{Binding HasNoSelectedDate}" />

                                <VerticalStackLayout
                                    Spacing="4"
                                    HorizontalOptions="Center"
                                    VerticalOptions="Center"
                                    IsVisible="{Binding HasNoAvailability}">
                                    <Label
                                        Text="Nema slobodnih termina"
                                        FontSize="16"
                                        FontAttributes="Bold"
                                        TextColor="{StaticResource TextOnBrandBackground}"
                                        HorizontalTextAlignment="Center" />
                                    <Label
                                        Text="Odaberite drugi datum."
                                        FontSize="13"
                                        TextColor="{StaticResource TextOnBrandBackground}"
                                        Opacity="0.8"
                                        HorizontalTextAlignment="Center" />
                                </VerticalStackLayout>

                                <CollectionView
                                    ItemsSource="{Binding AvailableSlots}"
                                    IsVisible="{Binding HasAvailability}"
                                    VerticalOptions="Fill"
                                    HeightRequest="250"
                                    SelectionMode="None">
                                    <CollectionView.ItemsLayout>
                                        <GridItemsLayout
                                            Orientation="Vertical"
                                            Span="3"
                                            VerticalItemSpacing="6"
                                            HorizontalItemSpacing="6" />
                                    </CollectionView.ItemsLayout>
                                    <CollectionView.ItemTemplate>
                                        <DataTemplate
                                            x:DataType="bookingResponses:AvailableTimeSlotResponse">
                                            <Button
                                                Text="{Binding StartsAt, StringFormat='{}{0:HH:mm}'}"
                                                Command="{Binding Source={x:Reference RootPage}, Path=BindingContext.CreateHoldCommand}"
                                                CommandParameter="{Binding .}"
                                                HeightRequest="44"
                                                Padding="0"
                                                BackgroundColor="{StaticResource QuickBookingPanelBackground}"
                                                BorderColor="{StaticResource PanelBorder}"
                                                BorderWidth="1"
                                                TextColor="{StaticResource TextOnBrandBackground}"
                                                FontSize="15"
                                                FontAttributes="Bold"
                                                CornerRadius="12" />
                                        </DataTemplate>
                                    </CollectionView.ItemTemplate>
                                </CollectionView>
                            </Grid>
                        </Border>

                    </VerticalStackLayout>

                </VerticalStackLayout>

            </VerticalStackLayout>

        </ScrollView>


        <!-- HOLD CONFIRMATION PANEL -->

        <Grid
            Grid.RowSpan="2"
            IsVisible="{Binding IsHoldConfirmationVisible}"
            ZIndex="100">

            <!-- BACKDROP -->

            <BoxView
                Color="#80000000" />

            <!-- PANEL -->

            <Border
                VerticalOptions="End"
                BackgroundColor="{StaticResource QuickBookingPanelBackground}"
                Stroke="{StaticResource PanelBorder}"
                StrokeThickness="1"
                StrokeShape="RoundRectangle 24,24,0,0"
                Padding="20,22,20,24">

                <VerticalStackLayout
                    Spacing="16">

                    <BoxView
                        HeightRequest="4"
                        WidthRequest="42"
                        CornerRadius="2"
                        HorizontalOptions="Center"
                        Color="{StaticResource PanelBorder}" />

                    <Label
                        Text="Potvrda termina"
                        FontSize="23"
                        FontAttributes="Bold"
                        TextColor="{StaticResource TextOnBrandBackground}" />

                    <Label
                        Text="Termin je privremeno zadržan. Potvrdite rezervaciju ili odustanite."
                        FontSize="14"
                        TextColor="{StaticResource TextOnBrandBackground}"
                        Opacity="0.8" />

                    <!-- EMPLOYEE -->

                    <Grid
                        ColumnDefinitions="*,Auto"
                        RowDefinitions="Auto,Auto,Auto,Auto"
                        RowSpacing="7">

                        <Label
                            Text="Zaposlenik"
                            FontSize="13"
                            TextColor="{StaticResource TextOnBrandBackground}"
                            Opacity="0.7" />

                        <Label
                            Grid.Row="0"
                            Grid.Column="1"
                            Text="{Binding HoldEmployeeName}"
                            FontSize="14"
                            FontAttributes="Bold"
                            TextColor="{StaticResource TextOnBrandBackground}" />

                        <Label
                            Grid.Row="1"
                            Text="Datum"
                            FontSize="13"
                            TextColor="{StaticResource TextOnBrandBackground}"
                            Opacity="0.7" />

                        <Label
                            Grid.Row="1"
                            Grid.Column="1"
                            Text="{Binding HoldStartsAtLocal, StringFormat='{}{0:dd.MM.yyyy.}'}"
                            FontSize="14"
                            FontAttributes="Bold"
                            TextColor="{StaticResource TextOnBrandBackground}" />

                        <Label
                            Grid.Row="2"
                            Text="Vrijeme"
                            FontSize="13"
                            TextColor="{StaticResource TextOnBrandBackground}"
                            Opacity="0.7" />

                        <Label
                            Grid.Row="2"
                            Grid.Column="1"
                            Text="{Binding HoldStartsAtLocal, StringFormat='{}{0:HH:mm}'}"
                            FontSize="14"
                            FontAttributes="Bold"
                            TextColor="{StaticResource TextOnBrandBackground}" />

                        <Label
                            Grid.Row="3"
                            Text="Trajanje"
                            FontSize="13"
                            TextColor="{StaticResource TextOnBrandBackground}"
                            Opacity="0.7" />

                        <Label
                            Grid.Row="3"
                            Grid.Column="1"
                            Text="{Binding BookingHold.TotalDurationMinutes, StringFormat='{}{0} min'}"
                            FontSize="14"
                            FontAttributes="Bold"
                            TextColor="{StaticResource TextOnBrandBackground}" />

                    </Grid>


                    <!-- PRICE -->

                    <Border
                        BackgroundColor="{StaticResource BrandBackground}"
                        Stroke="{StaticResource PanelBorder}"
                        StrokeThickness="0.8"
                        StrokeShape="RoundRectangle 14"
                        Padding="14">

                        <Grid
                            ColumnDefinitions="*,Auto">

                            <Label
                                Text="Ukupna cijena"
                                FontSize="14"
                                FontAttributes="Bold"
                                TextColor="{StaticResource TextOnBrandBackground}"
                                VerticalOptions="Center" />

                            <Label
                                Grid.Column="1"
                                Text="{Binding BookingHold.TotalPrice, StringFormat='{}{0:0.00} KM'}"
                                FontSize="18"
                                FontAttributes="Bold"
                                TextColor="{StaticResource BrandButton}"
                                VerticalOptions="Center" />

                        </Grid>

                    </Border>


                    <!-- EXPIRATION -->

                    <VerticalStackLayout
                        Spacing="3">

                        <Label
                            Text="Hold ističe"
                            FontSize="12"
                            TextColor="{StaticResource TextOnBrandBackground}"
                            Opacity="0.7" />

                        <Label
                            Text="{Binding HoldExpiresAtLocal, StringFormat='{}{0:HH:mm}'}"
                            FontSize="16"
                            FontAttributes="Bold"
                            TextColor="{StaticResource BrandButton}" />

                    </VerticalStackLayout>

                    <!-- ACTIONS -->

                    <Grid
                        ColumnDefinitions="*,*"
                        ColumnSpacing="10">

                        <Button
                            Grid.Column="0"
                            Text="ODUSTANI"
                            Command="{Binding CancelHoldCommand}"
                            HeightRequest="52"
                            CornerRadius="14"
                            BackgroundColor="{StaticResource QuickBookingPanelBackground}"
                            BorderColor="{StaticResource PanelBorder}"
                            BorderWidth="1"
                            TextColor="{StaticResource TextOnBrandBackground}"
                            FontAttributes="Bold" />

                        <Button
                            Grid.Column="1"
                            Text="POTVRDI REZERVACIJU"
                            Command="{Binding ConfirmBookingCommand}"
                            HeightRequest="52"
                            CornerRadius="14"
                            BackgroundColor="{StaticResource BrandButton}"
                            TextColor="{StaticResource BrandBackground}"
                            FontAttributes="Bold" />

                    </Grid>     

                </VerticalStackLayout>

            </Border>

        </Grid>

    </Grid>

</ContentPage>
