<?xml version="1.0" encoding="utf-8" ?>

<ContentPage
    x:Class="AppointmentBooking.Mobile.Views.Home.HomePage"
    xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
    xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
    xmlns:viewModels="clr-namespace:AppointmentBooking.Mobile.ViewModels.Home"
    xmlns:toolkit="http://schemas.microsoft.com/dotnet/2022/maui/toolkit"
    xmlns:bookingResponses="clr-namespace:AppointmentBooking.Mobile.Models.Bookings.Responses"
    xmlns:serviceResponses="clr-namespace:AppointmentBooking.Mobile.Models.BookableServices.Responses"
    x:Name="RootPage"
    x:DataType="viewModels:HomeViewModel"
    BackgroundColor="{StaticResource Background}"
    Shell.NavBarIsVisible="False"
    SafeAreaEdges="All">

    <ContentPage.Behaviors>
        <toolkit:EventToCommandBehavior
            EventName="Appearing"
            Command="{Binding Source={x:Reference RootPage}, Path=BindingContext.LoadServicesCommand}" />
    </ContentPage.Behaviors>

    <Grid
        RowDefinitions="Auto,*"
        Padding="20,18,20,0">

        <!-- HEADER -->
        <Grid
            Grid.Row="0"
            ColumnDefinitions="*,Auto"
            Margin="0,0,0,24">

            <VerticalStackLayout
                Grid.Column="0"
                Spacing="3">

                <Label
                    Text="Dobro došli"
                    FontSize="14"
                    TextColor="{StaticResource TextSecondary}" />

                <Label
                    Text="SALON"
                    FontSize="26"
                    CharacterSpacing="5"
                    FontAttributes="Bold"
                    TextColor="{StaticResource TextPrimary}" />

            </VerticalStackLayout>

            <Label
                Grid.Column="1"
                Text="✂"
                FontSize="34"
                TextColor="{StaticResource Accent}"
                VerticalOptions="Center" />

        </Grid>

        <!-- MAIN CONTENT -->
        <ScrollView Grid.Row="1">

            <VerticalStackLayout
                Spacing="24"
                Padding="0,0,0,24">

                <!-- QUICK BOOKING -->
                <Border
                    BackgroundColor="{StaticResource Primary}"
                    StrokeThickness="0"
                    StrokeShape="RoundRectangle 22"
                    Padding="20">

                    <VerticalStackLayout Spacing="16">

                        <VerticalStackLayout Spacing="4">

                            <Label
                                Text="Brza rezervacija"
                                FontSize="24"
                                FontAttributes="Bold"
                                TextColor="{StaticResource TextOnPrimary}" />

                            <Label
                                Text="Pronađite prvi slobodan termin."
                                FontSize="14"
                                TextColor="{StaticResource AccentLight}" />

                        </VerticalStackLayout>

                        <!-- SERVICE PICKER -->
                        <Border
                            BackgroundColor="{StaticResource Surface}"
                            StrokeThickness="0"
                            StrokeShape="RoundRectangle 14"
                            Padding="14,6">

                            <VerticalStackLayout Spacing="0">

                                <Label
                                    Text="USLUGA"
                                    FontSize="10"
                                    CharacterSpacing="1.5"
                                    TextColor="{StaticResource TextMuted}" />

                                <Picker
                                    Title="Odaberite uslugu"
                                    ItemsSource="{Binding ServicePickerItems}"
                                    SelectedItem="{Binding SelectedService, Mode=TwoWay}"
                                    ItemDisplayBinding="{Binding DisplayName}"
                                    FontSize="16"
                                    FontAttributes="Bold"
                                    TextColor="{StaticResource TextPrimary}"
                                    BackgroundColor="Transparent"
                                    HorizontalOptions="Fill"
                                    VerticalOptions="Center" />

                            </VerticalStackLayout>

                        </Border>

                        <!-- FIND AVAILABLE TIMES -->
                        <Button
                            Text="PRONAĐI SLOBODNE TERMINE   →"
                            Command="{Binding LoadQuickAvailabilityCommand}"
                            IsEnabled="{Binding CanSearchAvailability}"
                            TextColor="{StaticResource Primary}"
                            FontAttributes="Bold"
                            HeightRequest="52"
                            CornerRadius="14"
                            Margin="0,4,0,0">

                            <VisualStateManager.VisualStateGroups>
                                <VisualStateGroupList>

                                    <VisualStateGroup x:Name="CommonStates">

                                        <VisualState x:Name="Normal">
                                            <VisualState.Setters>

                                                <Setter
                                                    Property="BackgroundColor"
                                                    Value="{StaticResource Accent}" />

                                                <Setter
                                                    Property="TextColor"
                                                    Value="{StaticResource Primary}" />

                                            </VisualState.Setters>
                                        </VisualState>

                                        <VisualState x:Name="Disabled">
                                            <VisualState.Setters>

                                                <Setter
                                                    Property="BackgroundColor"
                                                    Value="{StaticResource Border}" />

                                                <Setter
                                                    Property="TextColor"
                                                    Value="{StaticResource TextMuted}" />

                                            </VisualState.Setters>
                                        </VisualState>

                                    </VisualStateGroup>

                                </VisualStateGroupList>
                            </VisualStateManager.VisualStateGroups>

                        </Button>

                    </VerticalStackLayout>

                </Border>

                <!-- SERVICES -->
                <VerticalStackLayout Spacing="14">

                    <Grid ColumnDefinitions="*,Auto">

                        <Label
            Text="Naše usluge"
            Style="{StaticResource TitleLabel}" />

                        <Label
            Grid.Column="1"
            Text="Sve"
            FontSize="13"
            FontAttributes="Bold"
            TextColor="{StaticResource AccentDark}"
            VerticalOptions="Center" />

                    </Grid>

                    <CollectionView
        ItemsSource="{Binding Services}"
        SelectionMode="None">

                        <CollectionView.ItemsLayout>
                            <GridItemsLayout
                Orientation="Vertical"
                Span="2"
                HorizontalItemSpacing="12"
                VerticalItemSpacing="12" />
                        </CollectionView.ItemsLayout>

                        <CollectionView.ItemTemplate>
                            <DataTemplate
                x:DataType="serviceResponses:ServiceResponse">

                                <Border
                    BackgroundColor="{StaticResource Surface}"
                    Stroke="{StaticResource Border}"
                    StrokeThickness="1"
                    StrokeShape="RoundRectangle 18"
                    Padding="16">

                                    <VerticalStackLayout Spacing="7">

                                        <Label
                            Text="{Binding Name}"
                            FontSize="18"
                            FontAttributes="Bold"
                            TextColor="{StaticResource TextPrimary}"
                            MaxLines="2" />

                                        <Label
                            Text="{Binding Description}"
                            FontSize="12"
                            TextColor="{StaticResource TextSecondary}"
                            MaxLines="2"
                            LineBreakMode="TailTruncation" />

                                        <Grid
                            ColumnDefinitions="*,Auto"
                            Margin="0,4,0,0">

                                            <Label
                                Text="{Binding DurationMinutes, StringFormat='{}{0} min'}"
                                FontSize="12"
                                TextColor="{StaticResource TextMuted}" />

                                            <Label
                                Grid.Column="1"
                                Text="{Binding Price, StringFormat='{}{0:0.00} KM'}"
                                FontSize="16"
                                FontAttributes="Bold"
                                TextColor="{StaticResource AccentDark}" />

                                        </Grid>

                                    </VerticalStackLayout>

                                </Border>

                            </DataTemplate>
                        </CollectionView.ItemTemplate>

                    </CollectionView>

                </VerticalStackLayout>

                <!-- BOOKING CTA -->
                <Border
                    BackgroundColor="{StaticResource SurfaceSecondary}"
                    StrokeThickness="0"
                    StrokeShape="RoundRectangle 18"
                    Padding="18">

                    <Grid ColumnDefinitions="*,Auto">

                        <VerticalStackLayout Spacing="4">

                            <Label
                                Text="Želite odabrati više usluga?"
                                FontSize="16"
                                FontAttributes="Bold"
                                TextColor="{StaticResource TextPrimary}" />

                            <Label
                                Text="Napravite rezervaciju po svojoj želji."
                                FontSize="12"
                                TextColor="{StaticResource TextSecondary}" />

                        </VerticalStackLayout>

                        <Label
                            Grid.Column="1"
                            Text="→"
                            FontSize="28"
                            TextColor="{StaticResource AccentDark}"
                            VerticalOptions="Center" />

                    </Grid>

                </Border>

            </VerticalStackLayout>

        </ScrollView>

        <!-- AVAILABLE TIMES MODAL -->
        <Grid
            Grid.Row="0"
            Grid.RowSpan="2"
            IsVisible="{Binding IsAvailabilityModalVisible}"
            BackgroundColor="#80000000"
            Padding="24">

            <Border
                BackgroundColor="{StaticResource Surface}"
                StrokeThickness="0"
                StrokeShape="RoundRectangle 24"
                Padding="20"
                VerticalOptions="Center"
                HorizontalOptions="Fill">

                <VerticalStackLayout Spacing="18">

                    <VerticalStackLayout Spacing="4">

                        <Label
                            Text="Slobodni termini"
                            FontSize="24"
                            FontAttributes="Bold"
                            TextColor="{StaticResource TextPrimary}" />

                        <Label
                            Text="{Binding QuickAvailability.Date, StringFormat='{}{0:dd.MM.yyyy.}'}"
                            FontSize="14"
                            FontAttributes="Bold"
                            TextColor="{StaticResource AccentDark}" />

                        <Label
                            Text="Odaberite termin koji vam odgovara."
                            FontSize="13"
                            TextColor="{StaticResource TextSecondary}" />

                    </VerticalStackLayout>

                    <CollectionView
                        ItemsSource="{Binding QuickAvailability.AvailableSlots}"
                        SelectedItem="{Binding SelectedTimeSlot, Mode=TwoWay}"
                        SelectionMode="Single"
                        HeightRequest="260">

                        <CollectionView.ItemTemplate>

                            <DataTemplate
                                x:DataType="bookingResponses:AvailableTimeSlotResponse">

                                <Border
                                    BackgroundColor="{StaticResource Background}"
                                    Stroke="{StaticResource Border}"
                                    StrokeThickness="1"
                                    StrokeShape="RoundRectangle 14"
                                    Padding="14"
                                    Margin="0,0,0,8">

                                    <Grid ColumnDefinitions="*,Auto">

                                        <VerticalStackLayout Spacing="2">

                                            <Label
                                                Text="{Binding StartsAt, StringFormat='{}{0:HH:mm}'}"
                                                FontSize="17"
                                                FontAttributes="Bold"
                                                TextColor="{StaticResource TextPrimary}" />

                                            <Label
                                                Text="{Binding EndsAt, StringFormat='do {0:HH:mm}'}"
                                                FontSize="12"
                                                TextColor="{StaticResource TextSecondary}" />

                                        </VerticalStackLayout>

                                        <Label
                                            Grid.Column="1"
                                            Text="›"
                                            FontSize="24"
                                            TextColor="{StaticResource AccentDark}"
                                            VerticalOptions="Center" />

                                    </Grid>

                                </Border>

                            </DataTemplate>

                        </CollectionView.ItemTemplate>

                    </CollectionView>

                    <Label
                        Text="{Binding SelectedTimeSlot.StartsAt, StringFormat='Odabrani termin: {0:HH:mm}'}"
                        FontSize="14"
                        FontAttributes="Bold"
                        TextColor="{StaticResource AccentDark}"
                        HorizontalOptions="Center" />

                    <Grid
                        ColumnDefinitions="*,*"
                        ColumnSpacing="10">

                        <Button
                            Grid.Column="0"
                            Text="OTKAŽI"
                            Command="{Binding CancelAvailabilityCommand}"
                            BackgroundColor="{StaticResource Background}"
                            TextColor="{StaticResource TextPrimary}"
                            FontAttributes="Bold"
                            HeightRequest="50"
                            CornerRadius="14" />

                        <Button
                            Grid.Column="1"
                            Text="POTVRDI"
                            Command="{Binding CreateHoldCommand}"
                            IsEnabled="{Binding CanConfirmBooking}"
                            BackgroundColor="{StaticResource Accent}"
                            TextColor="{StaticResource Primary}"
                            FontAttributes="Bold"
                            HeightRequest="50"
                            CornerRadius="14" />

                    </Grid>

                </VerticalStackLayout>

            </Border>

        </Grid>

        <!-- HOLD CONFIRMATION MODAL -->
        <Grid
            Grid.Row="0"
            Grid.RowSpan="2"
            IsVisible="{Binding IsHoldConfirmationVisible}"
            BackgroundColor="#80000000"
            Padding="24">

            <Border
                BackgroundColor="{StaticResource Surface}"
                StrokeThickness="0"
                StrokeShape="RoundRectangle 24"
                Padding="22"
                VerticalOptions="Center"
                HorizontalOptions="Fill">

                <VerticalStackLayout Spacing="18">

                    <VerticalStackLayout Spacing="5">

                        <Label
                            Text="Termin je privremeno rezervisan"
                            FontSize="23"
                            FontAttributes="Bold"
                            TextColor="{StaticResource TextPrimary}" />

                        <Label
                            Text="Provjerite podatke prije konačne potvrde."
                            FontSize="13"
                            TextColor="{StaticResource TextSecondary}" />

                    </VerticalStackLayout>

                    <Border
                        BackgroundColor="{StaticResource Background}"
                        Stroke="{StaticResource Border}"
                        StrokeThickness="1"
                        StrokeShape="RoundRectangle 16"
                        Padding="16">

                        <VerticalStackLayout Spacing="12">

                            <!-- USLUGA -->
                            <Grid ColumnDefinitions="Auto,*">

                                <Label
                                    Text="Usluga"
                                    FontSize="13"
                                    TextColor="{StaticResource TextSecondary}" />

                                <Label
                                    Grid.Column="1"
                                    Text="{Binding SelectedService.Name}"
                                    FontSize="14"
                                    FontAttributes="Bold"
                                    TextColor="{StaticResource TextPrimary}"
                                    HorizontalOptions="End" />

                            </Grid>

                            <!-- DATUM -->
                            <Grid ColumnDefinitions="Auto,*">

                                <Label
                                    Text="Datum"
                                    FontSize="13"
                                    TextColor="{StaticResource TextSecondary}" />

                                <Label
                                    Grid.Column="1"
                                    Text="{Binding HoldStartsAtLocal, StringFormat='{}{0:dd.MM.yyyy.}'}"
                                    FontSize="14"
                                    FontAttributes="Bold"
                                    TextColor="{StaticResource TextPrimary}"
                                    HorizontalOptions="End" />

                            </Grid>

                            <!-- VRIJEME -->
                            <Grid ColumnDefinitions="Auto,*">

                                <Label
                                    Text="Vrijeme"
                                    FontSize="13"
                                    TextColor="{StaticResource TextSecondary}" />

                                <Label
                                    Grid.Column="1"
                                    Text="{Binding HoldStartsAtLocal, StringFormat='{}{0:HH:mm}'}"
                                    FontSize="14"
                                    FontAttributes="Bold"
                                    TextColor="{StaticResource TextPrimary}"
                                    HorizontalOptions="End" />

                            </Grid>

                            <!-- TRAJANJE -->
                            <Grid ColumnDefinitions="Auto,*">

                                <Label
                                    Text="Trajanje"
                                    FontSize="13"
                                    TextColor="{StaticResource TextSecondary}" />

                                <Label
                                    Grid.Column="1"
                                    Text="{Binding BookingHold.TotalDurationMinutes, StringFormat='{}{0} min'}"
                                    FontSize="14"
                                    FontAttributes="Bold"
                                    TextColor="{StaticResource TextPrimary}"
                                    HorizontalOptions="End" />

                            </Grid>

                            <!-- CIJENA -->
                            <Grid ColumnDefinitions="Auto,*">

                                <Label
                                    Text="Cijena"
                                    FontSize="13"
                                    TextColor="{StaticResource TextSecondary}" />

                                <Label
                                    Grid.Column="1"
                                    Text="{Binding BookingHold.TotalPrice, StringFormat='{}{0:0.00} KM'}"
                                    FontSize="17"
                                    FontAttributes="Bold"
                                    TextColor="{StaticResource AccentDark}"
                                    HorizontalOptions="End" />

                            </Grid>

                            <BoxView
                                HeightRequest="1"
                                Color="{StaticResource Border}" />

                            <!-- HOLD EXPIRATION -->
                            <Label
                                Text="{Binding HoldExpiresAtLocal, StringFormat='Hold ističe: {0:HH:mm}'}"
                                FontSize="13"
                                FontAttributes="Bold"
                                TextColor="{StaticResource AccentDark}"
                                HorizontalOptions="Center" />

                        </VerticalStackLayout>

                    </Border>

                    <!-- HOLD ACTIONS -->
                    <Grid
                        ColumnDefinitions="*,*"
                        ColumnSpacing="10">

                        <Button
                            Grid.Column="0"
                            Text="ODUSTANI"
                            Command="{Binding CancelHoldConfirmationCommand}"
                            BackgroundColor="{StaticResource Background}"
                            TextColor="{StaticResource TextPrimary}"
                            FontAttributes="Bold"
                            HeightRequest="50"
                            CornerRadius="14" />

                        <Button
                            Grid.Column="1"
                            Text="POTVRDI REZERVACIJU"
                            Command="{Binding ConfirmHoldCommand}"
                            BackgroundColor="{StaticResource Accent}"
                            TextColor="{StaticResource Primary}"
                            FontAttributes="Bold"
                            HeightRequest="50"
                            CornerRadius="14" />

                    </Grid>

                </VerticalStackLayout>

            </Border>

        </Grid>

    </Grid>

</ContentPage>