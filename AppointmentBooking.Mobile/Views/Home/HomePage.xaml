<?xml version="1.0" encoding="utf-8" ?>

<ContentPage
    x:Class="AppointmentBooking.Mobile.Views.Home.HomePage"
    xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
    xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
    xmlns:viewModels="clr-namespace:AppointmentBooking.Mobile.ViewModels.Home"
    xmlns:toolkit="http://schemas.microsoft.com/dotnet/2022/maui/toolkit"
    xmlns:bookingResponses="clr-namespace:AppointmentBooking.Mobile.Models.Bookings.Responses"
    xmlns:serviceResponses="clr-namespace:AppointmentBooking.Mobile.Models.BookableServices.Responses"
    xmlns:servicePicker="clr-namespace:AppointmentBooking.Mobile.Models.BookableServices"
    x:Name="RootPage"
    x:DataType="viewModels:HomeViewModel"
    BackgroundColor="{StaticResource BrandBackground}"
    Shell.NavBarIsVisible="False"
    SafeAreaEdges="All">

    <ContentPage.Behaviors>
        <toolkit:EventToCommandBehavior
            EventName="Appearing"
            Command="{Binding Source={x:Reference RootPage}, Path=BindingContext.LoadServicesCommand}" />
    </ContentPage.Behaviors>

    <Grid
        RowDefinitions="Auto,*"
        Padding="20,18,20,0">

        <!-- HEADER -->
        <Grid
            x:Name="HeaderGrid"
            Grid.Row="0"
            ColumnDefinitions="*,Auto"
            Margin="0,0,0,24">

            <HorizontalStackLayout
                Grid.Column="0"
                Spacing="7"
                VerticalOptions="Center">

                <Label
                    Text="Zdravo,"
                    FontSize="22"
                    TextColor="{StaticResource TextOnBrandBackground}" />

                <Label
                    Text="{Binding GreetingName}"
                    FontSize="22"
                    FontAttributes="Bold"
                    TextColor="{StaticResource TextOnBrandBackground}" />

            </HorizontalStackLayout>

        </Grid>

        <!-- MAIN CONTENT -->
        <ScrollView x:Name="MainScrollView" Grid.Row="1">

            <VerticalStackLayout
                Spacing="24"
                Padding="0,0,0,24">

                <!-- QUICK BOOKING -->
                <Border
                    BackgroundColor="{StaticResource QuickBookingPanelBackground}"
                    Stroke="{StaticResource PanelBorder}"
                    StrokeThickness="0.8"
                    StrokeShape="RoundRectangle 22"
                    Padding="20">

                    <VerticalStackLayout Spacing="16">

                        <VerticalStackLayout Spacing="4">

                            <Label
                                Text="Brza rezervacija"
                                FontSize="24"
                                FontAttributes="Bold"
                            TextColor="{StaticResource TextOnBrandBackground}" />

                            <Label
                                Text="Pronađite prvi slobodan termin."
                                FontSize="14"
                            TextColor="{StaticResource TextOnBrandBackground}" />

                        </VerticalStackLayout>

                        <!-- SERVICE PICKER -->
                        <Border
                            BackgroundColor="{StaticResource TextBoxBackground}"
                            Stroke="{StaticResource BorderFocused}"
                            StrokeThickness="1"
                            StrokeShape="RoundRectangle 14"
                            Padding="14,6">

                            <Grid ColumnDefinitions="*,Auto">

                                <VerticalStackLayout Spacing="2">

                                    <Label
                                        Text="USLUGA"
                                        FontSize="10"
                                        CharacterSpacing="1.5"
                                        TextColor="{StaticResource TextMuted}" />

                                    <Label
                                        Text="{Binding SelectedService.Name, TargetNullValue='Odaberite uslugu'}"
                                        FontSize="16"
                                        FontAttributes="Bold"
                                        TextColor="{StaticResource TextPrimary}"
                                        LineBreakMode="TailTruncation" />

                                </VerticalStackLayout>

                                <Label
                                    Grid.Column="1"
                                    Text="⌄"
                                    FontSize="24"
                                    TextColor="{StaticResource BrandBackground}"
                                    VerticalOptions="Center" />

                            </Grid>

                            <Border.GestureRecognizers>
                                <TapGestureRecognizer Command="{Binding OpenServicePickerCommand}" />
                            </Border.GestureRecognizers>

                        </Border>

                        <!-- FIND AVAILABLE TIMES -->
                        <Button
                            Text="PRONAĐI SLOBODNE TERMINE"
                            Command="{Binding LoadQuickAvailabilityCommand}"
                            IsEnabled="{Binding CanSearchAvailability}"
                            TextColor="{StaticResource BrandBackground}"
                            FontAttributes="Bold"
                            HeightRequest="52"
                            CornerRadius="14"
                            Margin="0,4,0,0" BackgroundColor="{StaticResource BrandButton}">

                            <VisualStateManager.VisualStateGroups>
                                <VisualStateGroupList>

                                    <VisualStateGroup x:Name="CommonStates">

                                        <VisualState x:Name="Normal">
                                            <VisualState.Setters>

                                                <Setter
                                                    Property="BackgroundColor"
                                                    Value="{StaticResource BrandButton}" />

                                                <Setter
                                                    Property="TextColor"
                                                    Value="{StaticResource BrandBackground}" />

                                            </VisualState.Setters>
                                        </VisualState>

                                        <VisualState x:Name="Disabled">
                                            <VisualState.Setters>

                                                <Setter
                                                    Property="BackgroundColor"
                                                    Value="{StaticResource Border}" />

                                                <Setter
                                                    Property="TextColor"
                                                    Value="{StaticResource TextMuted}" />

                                            </VisualState.Setters>
                                        </VisualState>

                                    </VisualStateGroup>

                                </VisualStateGroupList>
                            </VisualStateManager.VisualStateGroups>

                        </Button>

                    </VerticalStackLayout>

                </Border>

                <!-- SERVICES -->
                <VerticalStackLayout Spacing="12">

                    <Label
                        Text="Usluge:"
                        FontSize="20"
                        FontAttributes="Bold"
                        TextColor="{StaticResource TextOnBrandBackground}"
                        Margin="4,0" />

                    <CollectionView
                        ItemsSource="{Binding FeaturedServices}"
                        SelectionMode="None"
                        Margin="0"
                        HorizontalOptions="Fill">

                        <CollectionView.ItemsLayout>
                            <GridItemsLayout
                Orientation="Vertical"
                Span="1"
                HorizontalItemSpacing="0"
                VerticalItemSpacing="12" />
                        </CollectionView.ItemsLayout>

                        <CollectionView.ItemTemplate>
                            <DataTemplate
                x:DataType="serviceResponses:ServiceResponse">

                                <Border
                                    BackgroundColor="{StaticResource QuickBookingPanelBackground}"
                                    Stroke="{StaticResource PanelBorder}"
                                    StrokeThickness="0.8"
                                    StrokeShape="RoundRectangle 14"
                                    HeightRequest="70"
                                    Padding="12,8"
                                    HorizontalOptions="Fill">

                                    <Grid RowDefinitions="*,Auto" RowSpacing="6">

                                        <Label
                                            Text="{Binding Name}"
                                            FontSize="16"
                                            FontAttributes="Bold"
                                            TextColor="{StaticResource TextOnBrandBackground}"
                                            MaxLines="1"
                                            LineBreakMode="TailTruncation"
                                            VerticalOptions="Start" />

                                        <Grid
                                            Grid.Row="1"
                                            ColumnDefinitions="Auto,*"
                                            ColumnSpacing="6">

                                            <Border
                                                BackgroundColor="{StaticResource BrandButton}"
                                                StrokeThickness="0"
                                                StrokeShape="RoundRectangle 9"
                                                Padding="7,4"
                                                VerticalOptions="Center">

                                                <Label
                                                    Text="{Binding DurationMinutes, StringFormat='{}{0} min'}"
                                                    FontSize="11"
                                                    FontAttributes="Bold"
                                                    TextColor="{StaticResource BrandBackground}"
                                                    VerticalOptions="Center" />

                                            </Border>

                                            <Label
                                                Grid.Column="1"
                                                Text="{Binding Price, StringFormat='{}{0:0.00} KM'}"
                                                FontSize="14"
                                                FontAttributes="Bold"
                                                TextColor="{StaticResource BrandButton}"
                                                HorizontalTextAlignment="End"
                                                VerticalOptions="Center" />

                                        </Grid>

                                    </Grid>

                                </Border>

                            </DataTemplate>
                        </CollectionView.ItemTemplate>

                    </CollectionView>

                </VerticalStackLayout>

                <!-- BOOKING CTA -->
                <Border
                    BackgroundColor="{StaticResource QuickBookingPanelBackground}"
                    Stroke="{StaticResource PanelBorder}"
                    StrokeThickness="0.8"
                    StrokeShape="RoundRectangle 18"
                    Padding="18"
                    Margin="0,12,0,0">

                    <Border.GestureRecognizers>
                        <TapGestureRecognizer Tapped="OnBookingClicked" />
                    </Border.GestureRecognizers>

                    <Grid ColumnDefinitions="*,Auto">

                        <VerticalStackLayout Spacing="4">

                            <Label
                                Text="Želite odabrati više usluga?"
                                FontSize="16"
                                FontAttributes="Bold"
                                TextColor="{StaticResource TextOnBrandBackground}" />

                            <Label
                                Text="Napravite rezervaciju po svojoj želji."
                                FontSize="12"
                                TextColor="{StaticResource TextOnBrandBackground}" />

                        </VerticalStackLayout>

                        <Label
                            Grid.Column="1"
                            Text="⟶"
                            FontSize="32"
                            FontAttributes="Bold"
                            TextColor="{StaticResource BrandButton}"
                            VerticalOptions="Center" />

                    </Grid>

                </Border>

            </VerticalStackLayout>

        </ScrollView>

        <!-- AVAILABLE TIMES MODAL -->
        <Grid
            x:Name="AvailableTimesOverlay"
            Grid.Row="0"
            Grid.RowSpan="2"
            IsVisible="{Binding IsAvailabilityModalVisible}"
            Padding="24">

            <Border
                BackgroundColor="{StaticResource QuickBookingPanelBackground}"
                Stroke="{StaticResource PanelBorder}"
                StrokeThickness="0.8"
                StrokeShape="RoundRectangle 24"
                Padding="20"
                VerticalOptions="Center"
                HorizontalOptions="Fill">

                <Border.Shadow>
                    <Shadow
                        Brush="#99000000"
                        Offset="0,12"
                        Radius="28"
                        Opacity="0.8" />
                </Border.Shadow>

                <VerticalStackLayout Spacing="18">

                    <VerticalStackLayout Spacing="4">

                        <Label
                            Text="Slobodni termini"
                            FontSize="24"
                            FontAttributes="Bold"
                            TextColor="{StaticResource TextOnBrandBackground}" />

                        <Label
                            Text="{Binding QuickAvailability.Date, StringFormat='{}{0:dd.MM.yyyy.}'}"
                            FontSize="14"
                            FontAttributes="Bold"
                            TextColor="{StaticResource BrandButton}" />

                        <Label
                            Text="Odaberite termin koji vam odgovara."
                            FontSize="13"
                            TextColor="{StaticResource TextOnBrandBackground}" />

                    </VerticalStackLayout>

                    <CollectionView
                        ItemsSource="{Binding QuickAvailability.AvailableSlots}"
                        SelectedItem="{Binding SelectedTimeSlot, Mode=TwoWay}"
                        SelectionMode="Single"
                        HeightRequest="260">

                        <CollectionView.ItemTemplate>

                            <DataTemplate
                                x:DataType="bookingResponses:AvailableTimeSlotResponse">

                                <Border
                                    BackgroundColor="{StaticResource TextBoxBackground}"
                                    Stroke="{StaticResource Border}"
                                    StrokeThickness="1"
                                    StrokeShape="RoundRectangle 14"
                                    Padding="14"
                                    Margin="0,0,0,8">

                                    <VisualStateManager.VisualStateGroups>
                                        <VisualStateGroup x:Name="CommonStates">
                                            <VisualState x:Name="Normal">
                                                <VisualState.Setters>
                                                    <Setter
                                                        Property="BackgroundColor"
                                                        Value="{StaticResource TextBoxBackground}" />
                                                    <Setter
                                                        Property="Stroke"
                                                        Value="{StaticResource Border}" />
                                                </VisualState.Setters>
                                            </VisualState>
                                            <VisualState x:Name="Selected">
                                                <VisualState.Setters>
                                                    <Setter
                                                        Property="BackgroundColor"
                                                        Value="{StaticResource BrandButton}" />
                                                    <Setter
                                                        Property="Stroke"
                                                        Value="{StaticResource BrandButton}" />
                                                </VisualState.Setters>
                                            </VisualState>
                                        </VisualStateGroup>
                                    </VisualStateManager.VisualStateGroups>

                                    <Grid ColumnDefinitions="*,Auto">

                                        <VerticalStackLayout Spacing="2">

                                            <Label
                                                Text="{Binding StartsAt, StringFormat='{}{0:HH:mm}'}"
                                                FontSize="17"
                                                FontAttributes="Bold"
                                                TextColor="{StaticResource TextPrimary}" />

                                            <Label
                                                Text="{Binding EndsAt, StringFormat='do {0:HH:mm}'}"
                                                FontSize="12"
                                                TextColor="{StaticResource TextSecondary}" />

                                        </VerticalStackLayout>

                                        <Label
                                            Grid.Column="1"
                                            Text="›"
                                            FontSize="24"
                                            TextColor="{StaticResource BrandBackground}"
                                            VerticalOptions="Center" />

                                    </Grid>

                                </Border>

                            </DataTemplate>

                        </CollectionView.ItemTemplate>

                    </CollectionView>

                    <Label
                        Text="{Binding SelectedTimeSlot.StartsAt, StringFormat='Odabrani termin: {0:HH:mm}'}"
                        FontSize="14"
                        FontAttributes="Bold"
                        TextColor="{StaticResource TextOnBrandBackground}"
                        HorizontalOptions="Center" />

                    <Grid
                        ColumnDefinitions="*,*"
                        ColumnSpacing="10">

                        <Button
                            Grid.Column="0"
                            Text="OTKAŽI"
                            Command="{Binding CancelAvailabilityCommand}"
                            BackgroundColor="{StaticResource QuickBookingPanelBackground}"
                            BorderColor="{StaticResource PanelBorder}"
                            BorderWidth="1"
                            TextColor="{StaticResource TextOnBrandBackground}"
                            FontAttributes="Bold"
                            HeightRequest="50"
                            CornerRadius="14" />

                        <Button
                            Grid.Column="1"
                            Text="POTVRDI"
                            Command="{Binding CreateHoldCommand}"
                            IsEnabled="{Binding CanConfirmBooking}"
                            BackgroundColor="{StaticResource BrandButton}"
                            TextColor="{StaticResource BrandBackground}"
                            FontAttributes="Bold"
                            HeightRequest="50"
                            CornerRadius="14" />

                    </Grid>

                </VerticalStackLayout>

            </Border>

        </Grid>

        <!-- HOLD CONFIRMATION MODAL -->
        <Grid
            Grid.Row="0"
            Grid.RowSpan="2"
            IsVisible="{Binding IsHoldConfirmationVisible}"
            BackgroundColor="#80000000"
            Padding="24">

            <Border
                BackgroundColor="{StaticResource QuickBookingPanelBackground}"
                Stroke="{StaticResource PanelBorder}"
                StrokeThickness="1"
                StrokeShape="RoundRectangle 24"
                Padding="22"
                VerticalOptions="Center"
                HorizontalOptions="Fill">

                <VerticalStackLayout Spacing="16">

                    <VerticalStackLayout Spacing="5">

                        <Label
                            Text="Potvrda termina"
                            FontSize="23"
                            FontAttributes="Bold"
                            TextColor="{StaticResource TextOnBrandBackground}" />

                        <Label
                            Text="Provjerite podatke prije konačne potvrde."
                            FontSize="13"
                            TextColor="{StaticResource TextOnBrandBackground}"
                            Opacity="0.8" />

                    </VerticalStackLayout>

                    <Border
                        BackgroundColor="{StaticResource BrandBackground}"
                        Stroke="{StaticResource PanelBorder}"
                        StrokeThickness="0.8"
                        StrokeShape="RoundRectangle 16"
                        Padding="16">

                        <VerticalStackLayout Spacing="12">

                            <!-- USLUGA -->
                            <Grid ColumnDefinitions="*,Auto">

                                <Label
                                    Text="Usluga"
                                    FontSize="13"
                                    TextColor="{StaticResource TextOnBrandBackground}"
                                    Opacity="0.7" />

                                <Label
                                    Grid.Column="1"
                                    Text="{Binding SelectedService.Name}"
                                    FontSize="14"
                                    FontAttributes="Bold"
                                    TextColor="{StaticResource TextOnBrandBackground}"
                                    HorizontalOptions="End" />

                            </Grid>

                            <!-- DATUM -->
                            <Grid ColumnDefinitions="*,Auto">

                                <Label
                                    Text="Datum"
                                    FontSize="13"
                                    TextColor="{StaticResource TextOnBrandBackground}"
                                    Opacity="0.7" />

                                <Label
                                    Grid.Column="1"
                                    Text="{Binding HoldStartsAtLocal, StringFormat='{}{0:dd.MM.yyyy.}'}"
                                    FontSize="14"
                                    FontAttributes="Bold"
                                    TextColor="{StaticResource TextOnBrandBackground}"
                                    HorizontalOptions="End" />

                            </Grid>

                            <!-- VRIJEME -->
                            <Grid ColumnDefinitions="*,Auto">

                                <Label
                                    Text="Vrijeme"
                                    FontSize="13"
                                    TextColor="{StaticResource TextOnBrandBackground}"
                                    Opacity="0.7" />

                                <Label
                                    Grid.Column="1"
                                    Text="{Binding HoldStartsAtLocal, StringFormat='{}{0:HH:mm}'}"
                                    FontSize="14"
                                    FontAttributes="Bold"
                                    TextColor="{StaticResource TextOnBrandBackground}"
                                    HorizontalOptions="End" />

                            </Grid>

                            <!-- TRAJANJE -->
                            <Grid ColumnDefinitions="*,Auto">

                                <Label
                                    Text="Trajanje"
                                    FontSize="13"
                                    TextColor="{StaticResource TextOnBrandBackground}"
                                    Opacity="0.7" />

                                <Label
                                    Grid.Column="1"
                                    Text="{Binding BookingHold.TotalDurationMinutes, StringFormat='{}{0} min'}"
                                    FontSize="14"
                                    FontAttributes="Bold"
                                    TextColor="{StaticResource TextOnBrandBackground}"
                                    HorizontalOptions="End" />

                            </Grid>

                            <!-- CIJENA -->
                            <Grid ColumnDefinitions="*,Auto">

                                <Label
                                    Text="Cijena"
                                    FontSize="13"
                                    TextColor="{StaticResource TextOnBrandBackground}"
                                    Opacity="0.7" />

                                <Label
                                    Grid.Column="1"
                                    Text="{Binding BookingHold.TotalPrice, StringFormat='{}{0:0.00} KM'}"
                                    FontSize="17"
                                    FontAttributes="Bold"
                                    TextColor="{StaticResource BrandButton}"
                                    HorizontalOptions="End" />

                            </Grid>

                            <BoxView
                                HeightRequest="1"
                                Color="{StaticResource PanelBorder}" />

                            <!-- HOLD EXPIRATION -->
                            <Label
                                Text="{Binding HoldExpiresAtLocal, StringFormat='Hold ističe: {0:HH:mm}'}"
                                FontSize="13"
                                FontAttributes="Bold"
                                TextColor="{StaticResource BrandButton}"
                                HorizontalOptions="Center" />

                        </VerticalStackLayout>

                    </Border>

                    <!-- HOLD ACTIONS -->
                    <Grid
                        ColumnDefinitions="*,*"
                        ColumnSpacing="10">

                        <Button
                            Grid.Column="0"
                            Text="ODUSTANI"
                            Command="{Binding CancelHoldConfirmationCommand}"
                            BackgroundColor="{StaticResource BrandBackground}"
                            BorderColor="{StaticResource PanelBorder}"
                            BorderWidth="1"
                            TextColor="{StaticResource TextOnBrandBackground}"
                            FontAttributes="Bold"
                            HeightRequest="50"
                            CornerRadius="14" />

                        <Button
                            Grid.Column="1"
                            Text="POTVRDI REZERVACIJU"
                            Command="{Binding ConfirmHoldCommand}"
                            BackgroundColor="{StaticResource BrandButton}"
                            TextColor="{StaticResource BrandBackground}"
                            FontAttributes="Bold"
                            HeightRequest="50"
                            CornerRadius="14" />

                    </Grid>

                </VerticalStackLayout>

            </Border>

        </Grid>

        <!-- SERVICE PICKER -->
        <Grid
            Grid.Row="0"
            Grid.RowSpan="2"
            x:Name="ServicePickerOverlay"
            IsVisible="{Binding IsServicePickerVisible}"
            Padding="24">

            <Border
                BackgroundColor="{StaticResource QuickBookingPanelBackground}"
                Stroke="{StaticResource PanelBorder}"
                StrokeThickness="0.8"
                StrokeShape="RoundRectangle 26"
                Padding="20"
                VerticalOptions="Center"
                HorizontalOptions="Fill">

                <Border.Shadow>
                    <Shadow
                        Brush="#99000000"
                        Offset="0,12"
                        Radius="28"
                        Opacity="0.8" />
                </Border.Shadow>

                <VerticalStackLayout Spacing="16">

                    <VerticalStackLayout Spacing="4">

                        <Label
                            Text="Odaberite uslugu"
                            FontSize="22"
                            FontAttributes="Bold"
                            TextColor="{StaticResource TextOnBrandBackground}" />

                        <Label
                            Text="Odaberite uslugu za brzu rezervaciju."
                            FontSize="13"
                            TextColor="{StaticResource TextOnBrandBackground}" />

                    </VerticalStackLayout>

                    <CollectionView
                        ItemsSource="{Binding ServicePickerItems}"
                        SelectionMode="None"
                        MaximumHeightRequest="320">

                        <CollectionView.ItemsLayout>
                            <LinearItemsLayout
                                Orientation="Vertical"
                                ItemSpacing="8" />
                        </CollectionView.ItemsLayout>

                        <CollectionView.ItemTemplate>
                            <DataTemplate x:DataType="servicePicker:ServicePickerItem">

                                <Border
                                    BackgroundColor="{StaticResource TextBoxBackground}"
                                    Stroke="{StaticResource Border}"
                                    StrokeThickness="0.8"
                                    StrokeShape="RoundRectangle 14"
                                    Padding="14,12">

                                    <Border.GestureRecognizers>
                                        <TapGestureRecognizer
                                            Command="{Binding Source={x:Reference RootPage}, Path=BindingContext.SelectServiceCommand}"
                                            CommandParameter="{Binding .}" />
                                    </Border.GestureRecognizers>

                                    <Grid ColumnDefinitions="*,Auto,Auto" ColumnSpacing="12">

                                        <Label
                                            Text="{Binding Name}"
                                            FontSize="15"
                                            FontAttributes="Bold"
                                            TextColor="{StaticResource TextPrimary}"
                                            VerticalOptions="Center"
                                            LineBreakMode="TailTruncation" />

                                        <Label
                                            Grid.Column="1"
                                            Text="{Binding Price, StringFormat='{}{0:0.00} KM'}"
                                            FontSize="14"
                                            FontAttributes="Bold"
                                            TextColor="{StaticResource BrandBackground}"
                                            VerticalOptions="Center" />

                                        <Label
                                            Grid.Column="2"
                                            Text="›"
                                            FontSize="24"
                                            FontAttributes="Bold"
                                            TextColor="{StaticResource AccentDark}"
                                            VerticalOptions="Center" />

                                    </Grid>

                                </Border>

                            </DataTemplate>
                        </CollectionView.ItemTemplate>

                    </CollectionView>

                    <Button
                        Text="ZATVORI"
                        Command="{Binding CloseServicePickerCommand}"
                        BackgroundColor="{StaticResource BrandButton}"
                        TextColor="{StaticResource BrandBackground}"
                        FontAttributes="Bold"
                        HeightRequest="48"
                        CornerRadius="14" />

                </VerticalStackLayout>

            </Border>

        </Grid>

    </Grid>

</ContentPage>
